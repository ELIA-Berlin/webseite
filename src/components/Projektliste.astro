---
/** Liste der Projekte, genutzt auf der Startseite und der Projektübersicht. */
import { statusText } from '../lib/inhalte';

interface Props {
  projekte: { slug: string; entry: { titel: string; kurzbeschreibung: string; wettbewerb: string; status: string } }[];
  ueberschrift?: 'h2' | 'h3';
}
const { projekte, ueberschrift = 'h3' } = Astro.props;
const Ueberschrift = ueberschrift;
---
<ul class="projekte">
  {projekte.map(({ slug, entry }) => (
    <li class="projekt">
      <a href={`/projekte/${slug}`} class="projekt__link">
        <Ueberschrift class="projekt__titel">{entry.titel}</Ueberschrift>
        <p class="projekt__text">{entry.kurzbeschreibung}</p>
        <p class="projekt__meta">
          <span class={`status status--${entry.status}`}>{statusText[entry.status] ?? entry.status}</span>
          {entry.wettbewerb && <span>{entry.wettbewerb}</span>}
        </p>
      </a>
    </li>
  ))}
</ul>

<style>
  .projekte { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linie); }
  .projekt { border-bottom: 1px solid var(--linie); }
  .projekt__link {
    display: grid;
    gap: 0.4rem 2rem;
    padding: 1.6rem 0;
    text-decoration: none;
  }
  @media (min-width: 48rem) {
    .projekt__link { grid-template-columns: minmax(12rem, 1fr) 2fr; align-items: baseline; }
    .projekt__meta { grid-column: 2; }
  }
  .projekt__titel { margin: 0; font-size: var(--s-h3); }
  .projekt__link:hover .projekt__titel { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  .projekt__text { margin: 0; max-width: 38rem; }
  .projekt__meta { margin: 0.3rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font-size: var(--s-klein); color: var(--grau); }
  .status { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--nacht); font-weight: 700; }
  .status::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: currentColor; }
  .status--aktiv::before { background: #1f9d6b; }
  .status--planung::before { background: transparent; box-shadow: inset 0 0 0 2px var(--nacht); }
  .status--abgeschlossen::before { background: var(--grau); }
</style>

---
/**
 * Abschnitt „Technik“ der Raketenseite als dunkles Band über die ganze Breite:
 * links Überschrift, Text und Umschalter, rechts Stella als Explosionszeichnung,
 * unten das Schriftfeld wie auf einem Zeichnungsblatt.
 *
 * Beim Scrollen fährt die Rakete in ihre Baugruppen auseinander – Nasenkonus, Nutzlast,
 * Avionik, Bergung, Motor mit Leitwerk – und die Beschriftungen erscheinen nacheinander.
 * Das läuft im normalen Scrollen mit und hält nichts an. Mit dem Umschalter
 * „Zusammen / Auseinander“ wählt man die Ansicht selbst; danach folgt sie nicht mehr dem Scrollen.
 *
 * Bei „Bewegung reduzieren“ steht die Zeichnung auseinandergezogen da (Umschalter ohne Animation),
 * ohne JavaScript zusammengebaut mit allen Beschriftungen und ohne Umschalter.
 *
 * Beschriftungen: src/content/themen/rakete.yaml → technik → raketenzeichnung.
 */
import Schriftfeld from './Schriftfeld.astro';

interface Props {
  titel: string;
  b: {
    nasenkonus: string; nutzlast: string; avionik: string; bergung: string;
    motor: string; leitwerk: string; hinweis: string; beschreibung: string;
    schriftfeld?: readonly { name: string; wert: string }[];
  };
}
const { titel, b } = Astro.props;

/*
 * Baugruppen von oben nach unten. „weg“ ist die Verschiebung im auseinandergezogenen Zustand.
 * Rumpf: x 248–312, Mitte 280.
 */
const gruppen = [
  { name: 'nase', weg: -112 },
  { name: 'nutzlast', weg: -66 },
  { name: 'avionik', weg: -22 },
  { name: 'bergung', weg: 24 },
  { name: 'motor', weg: 78 },
];
const felder = b.schriftfeld ?? [];
---
<section class:list={['technik', 'dunkel', 'raster', 'leuchten', { 'mit-feld': felder.length > 0 }]} data-explosion>
  <div class="huelle technik__raster">
    <div class="technik__text">
      <h2>{titel}</h2>
      <div class="technik__inhalt"><slot /></div>
      <div class="umschalter" role="group" aria-label="Ansicht der Zeichnung" hidden>
        <button type="button" data-ansicht="0" aria-pressed="true">Zusammen</button>
        <button type="button" data-ansicht="1" aria-pressed="false">Auseinander</button>
      </div>
    </div>
  <svg class="zeichnung" viewBox="0 -100 560 880" role="img" aria-label={b.beschreibung}>
    <line class="achse" x1="280" y1="-90" x2="280" y2="770" />

    <g class="gruppe" data-weg={gruppen[0].weg}>
      <path class="flaeche kontur" d="M280 40 C 300 80, 312 130, 312 175 L 248 175 C 248 130, 260 80, 280 40 Z" />
      <g class="ruf" data-reihe="0"><circle cx="280" cy="120" r="3" /><path d="M280 120 L 200 120 L 180 102 L 40 102" /><text x="40" y="94">{b.nasenkonus}</text></g>
    </g>

    <g class="gruppe" data-weg={gruppen[1].weg}>
      <rect class="flaeche kontur" x="248" y="175" width="64" height="83" />
      <rect class="innen" x="258" y="190" width="44" height="52" />
      <g class="ruf" data-reihe="1"><circle cx="280" cy="216" r="3" /><path d="M280 216 L 370 216 L 390 196 L 530 196" /><text class="rechts" x="530" y="188">{b.nutzlast}</text></g>
    </g>

    <g class="gruppe" data-weg={gruppen[2].weg}>
      <rect class="flaeche kontur" x="248" y="258" width="64" height="72" />
      <rect class="innen" x="262" y="270" width="36" height="46" />
      <g class="ruf" data-reihe="2"><circle cx="280" cy="292" r="3" /><path d="M280 292 L 190 292 L 170 272 L 40 272" /><text x="40" y="264">{b.avionik}</text></g>
    </g>

    <g class="gruppe" data-weg={gruppen[3].weg}>
      <rect class="flaeche kontur" x="248" y="330" width="64" height="90" />
      <path class="innen" d="M262 345 q 18 -14 36 0 l -18 52 z" />
      <g class="ruf" data-reihe="3"><circle cx="280" cy="372" r="3" /><path d="M280 372 L 370 372 L 390 352 L 530 352" /><text class="rechts" x="530" y="344">{b.bergung}</text></g>
    </g>

    <g class="gruppe" data-weg={gruppen[4].weg}>
      <rect class="flaeche kontur" x="248" y="420" width="64" height="180" />
      <rect class="innen" x="256" y="436" width="48" height="160" />
      <path class="kontur" d="M248 520 L 196 610 L 196 640 L 248 600 M312 520 L 364 610 L 364 640 L 312 600" />
      <path class="kontur" d="M266 600 L 262 628 L 298 628 L 294 600" />
      <g class="ruf" data-reihe="4"><circle cx="280" cy="516" r="3" /><path d="M280 516 L 190 516 L 170 496 L 40 496" /><text x="40" y="488">{b.motor}</text></g>
      <g class="ruf" data-reihe="5"><circle cx="350" cy="612" r="3" /><path d="M350 612 L 400 612 L 420 592 L 530 592" /><text class="rechts" x="530" y="584">{b.leitwerk}</text></g>
    </g>

    {b.hinweis && <text class="hinweis" x="40" y="764">{b.hinweis}</text>}
  </svg>
  </div>
  {felder.length > 0 && (
    <div class="huelle technik__feld">
      <Schriftfeld dunkel felder={[...felder]} />
    </div>
  )}
</section>

<style>
  .technik {
    --raster-y: -1px;
    color: var(--weiss);
    padding: clamp(3.5rem, 8vw, 5.5rem) 0;
  }
  .technik.mit-feld { padding-bottom: 0; }
  .technik__raster { display: grid; gap: 2.5rem 4rem; align-items: center; }
  @media (min-width: 56rem) {
    .technik__raster { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
  }
  h2 { font-size: clamp(1.75rem, 1.35rem + 1.4vw, 2.4rem); margin: 0 0 1.2rem; }
  .technik__inhalt { max-width: 34rem; color: rgb(255 255 255 / 0.82); }
  .technik__inhalt > :global(p:first-child) { font-size: 1.3rem; line-height: 1.5; color: var(--weiss); }
  .technik__inhalt > :global(:last-child) { margin-bottom: 0; }

  /* Umschalter: zwei Kästchen wie im Schriftfeld, das gewählte ist hell */
  .umschalter { display: inline-flex; margin-top: 2rem; border: 1px solid rgb(255 255 255 / 0.4); border-radius: 4px; overflow: hidden; }
  .umschalter[hidden] { display: none; }
  .umschalter button {
    font: 600 1.05rem var(--schrift-titel); padding: 0.6rem 1.2rem; cursor: pointer;
    background: transparent; color: rgb(255 255 255 / 0.8); border: 0;
  }
  .umschalter button + button { border-left: 1px solid rgb(255 255 255 / 0.4); }
  .umschalter button:hover { background: rgb(255 255 255 / 0.08); color: var(--weiss); }
  .umschalter button[aria-pressed='true'] { background: var(--weiss); color: var(--nacht); }
  .umschalter button:focus-visible { outline: 2px solid var(--weiss); outline-offset: 2px; }

  /* Zeichnung höchstens so hoch, dass sie ganz auf den Bildschirm passt */
  .zeichnung {
    width: 100%; max-width: min(32rem, calc((100vh - 6rem) * 0.636));
    display: block; justify-self: center; overflow: visible;
  }
  .technik__feld { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .technik__feld :global(.schriftfeld) { border-bottom: 0; }

  text { font-family: var(--schrift-titel); font-size: 17px; font-weight: 500; fill: rgb(255 255 255 / 0.85); }
  .rechts { text-anchor: end; }
  .hinweis { font-size: 13px; fill: rgb(255 255 255 / 0.5); }
  .kontur { fill: none; stroke: var(--weiss); stroke-width: 1.6; }
  .flaeche { fill: rgb(255 255 255 / 0.05); }
  .innen { fill: none; stroke: rgb(255 255 255 / 0.45); stroke-width: 1; stroke-dasharray: 5 4; }
  .achse { stroke: rgb(255 255 255 / 0.3); stroke-width: 1; stroke-dasharray: 18 4 3 4; }
  .ruf path { fill: none; stroke: rgb(255 255 255 / 0.5); stroke-width: 1; }
  .ruf circle { fill: var(--weiss); filter: drop-shadow(0 0 4px rgb(210 230 248 / 0.9)); }
  @media (max-width: 40rem) { text { font-size: 24px; } .hinweis { font-size: 19px; } }
</style>

<script>
  /*
   * e = 0 zusammengebaut, 1 auseinandergezogen. Beschriftungen: 0 = keine, ab 1.9 = alle.
   * Zuerst folgt die Zeichnung dem Scrollen: Sie fährt auseinander, während ihre Mitte
   * vom unteren Bildschirmrand in die Bildschirmmitte wandert. Nach einem Klick auf den
   * Umschalter gilt nur noch die gewählte Ansicht.
   */
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-explosion]').forEach((box) => {
    const svg = box.querySelector<SVGSVGElement>('.zeichnung')!;
    const gruppen = [...box.querySelectorAll<SVGGElement>('.gruppe')].map((g) => ({ g, weg: Number(g.dataset.weg) }));
    const rufe = [...box.querySelectorAll<SVGGElement>('.ruf')];
    const umschalter = box.querySelector<HTMLElement>('.umschalter')!;
    const knoepfe = [...umschalter.querySelectorAll<HTMLButtonElement>('button')];
    umschalter.hidden = false;

    const weich = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const klemme = (x: number) => Math.min(1, Math.max(0, x));

    const setze = (e: number, beschriftung: number) => {
      gruppen.forEach(({ g, weg }) => g.setAttribute('transform', `translate(0 ${weg * e})`));
      rufe.forEach((r, i) => {
        // Beschriftungen erscheinen nacheinander von oben nach unten
        r.style.opacity = String(klemme((beschriftung - i * 0.13) / 0.2));
      });
      const auseinander = e > 0.5;
      knoepfe.forEach((k) => k.setAttribute('aria-pressed', String((k.dataset.ansicht === '1') === auseinander)));
    };

    // Zustand: aktuell und Ziel, jeweils Auseinander-Anteil und Beschriftung
    let handbetrieb = false;
    const jetzt = { e: 0, b: 0 };
    const ziel = { e: 0, b: 0 };
    let laeuft = false;

    const ausScroll = () => {
      const r = svg.getBoundingClientRect();
      const vh = window.innerHeight;
      const t = klemme((vh * 1.05 - (r.top + r.height / 2)) / (vh * 0.55));
      ziel.e = weich(klemme((t - 0.1) / 0.6));
      ziel.b = klemme((t - 0.25) / 0.65) * 1.9;
    };
    function schritt() {
      jetzt.e += (ziel.e - jetzt.e) * 0.12;
      jetzt.b += (ziel.b - jetzt.b) * 0.12;
      const fertig = Math.abs(ziel.e - jetzt.e) < 0.001 && Math.abs(ziel.b - jetzt.b) < 0.001;
      if (fertig) { jetzt.e = ziel.e; jetzt.b = ziel.b; }
      setze(jetzt.e, jetzt.b);
      if (!fertig) requestAnimationFrame(schritt);
      else laeuft = false;
    }
    const los = () => { if (!laeuft) { laeuft = true; requestAnimationFrame(schritt); } };

    knoepfe.forEach((k) => k.addEventListener('click', () => {
      handbetrieb = true;
      ziel.e = Number(k.dataset.ansicht);
      ziel.b = 2; // im Handbetrieb immer alle Beschriftungen
      if (ruhig) { jetzt.e = ziel.e; jetzt.b = ziel.b; setze(jetzt.e, jetzt.b); }
      else los();
    }));

    if (ruhig) { jetzt.e = ziel.e = 1; jetzt.b = ziel.b = 2; setze(1, 2); return; }

    const messen = () => { if (handbetrieb) return; ausScroll(); los(); };
    window.addEventListener('scroll', messen, { passive: true });
    window.addEventListener('resize', messen);
    ausScroll();
    jetzt.e = ziel.e; jetzt.b = ziel.b;
    setze(jetzt.e, jetzt.b);
  });
</script>

---
/**
 * Themen als kleine Zeichnungsblätter (Startseite): Rahmen, Skizze auf Millimeterpapier,
 * Titel und Kurztext, unten ein Schriftfeld mit der Einordnung (z. B. Wettbewerb).
 * Die Skizzen liegen in public/grafiken/themen/ (Feld „Skizze“ im Editor).
 */
import Platzhalter from './Platzhalter.astro';
import Schriftfeld from './Schriftfeld.astro';
interface Props {
  themen: { slug: string; entry: { titel: string; einordnung?: string | null; skizze?: string | null; kurztext?: string | null; wettbewerb?: { readonly discriminant: boolean; readonly value?: { readonly name?: string } | null } } }[];
  /** Bezeichnung im Schriftfeld, z. B. „Bereich“ */
  einordnungName?: string;
  wettbewerbName?: string;
}
const { themen, einordnungName = 'Bereich', wettbewerbName = 'Wettbewerb' } = Astro.props;
const istWettbewerb = (e: Props['themen'][number]['entry']) =>
  Boolean(e.wettbewerb?.discriminant && e.wettbewerb.value?.name && e.wettbewerb.value.name === e.einordnung);
---
<ul class="blaetter">
  {themen.map(({ slug, entry }) => (
    <li>
      <a class="blatt" href={`/themen/${slug}`}>
        <span class="skizze raster-hell">
          {entry.skizze && <img src={entry.skizze} alt="" loading="lazy" />}
        </span>
        <span class="text">
          <h3>{entry.titel}</h3>
          {entry.kurztext ? <p>{entry.kurztext}</p> : <Platzhalter text="ein kurzer Satz" />}
        </span>
        <Schriftfeld klein class="feld" felder={[{ name: istWettbewerb(entry) ? wettbewerbName : einordnungName, wert: entry.einordnung }]} />
      </a>
    </li>
  ))}
</ul>

<style>
  .blaetter {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1.25rem;
  }
  @media (min-width: 40rem) { .blaetter { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .blaetter { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* Rahmen wie ein Zeichnungsblatt: außen eine Linie, das Schriftfeld schließt unten ab */
  .blatt {
    display: flex; flex-direction: column; height: 100%;
    border: 1.5px solid var(--navy);
    text-decoration: none; background: var(--weiss);
  }
  .skizze { display: grid; place-items: center; aspect-ratio: 16 / 9; border-bottom: 1px solid var(--navy); }
  .skizze img { max-height: 70%; max-width: 75%; width: auto; height: auto; }
  .text { display: block; padding: 1.1rem 1rem 1.3rem; flex: 1; }
  h3 { font-size: 2rem; margin: 0 0 0.35rem; }
  p { margin: 0; color: var(--grau); font-size: 1rem; line-height: 1.5; }

  /* Das Schriftfeld liegt bündig im Rahmen: keine doppelten Außenlinien */
  .blatt :global(.feld) { border-left: 0; border-top-width: 1px; }
  .blatt :global(.feld > div) { border-bottom: 0; }
  .blatt :global(.feld > div:last-child) { border-right: 0; }

  .blatt:hover h3 { text-decoration: underline; text-underline-offset: 0.12em; text-decoration-thickness: 2px; }
  .blatt:hover .skizze { background-color: var(--ring-tief); }
  .blatt:focus-visible { outline-offset: 4px; }
</style>

---
/** Dunkler Kopfbereich einer Unterseite: kleine Zeile, Überschrift, Einleitung, optional Bild. */
interface Props {
  titel: string;
  einordnung?: string | null;
  einleitung?: string | null;
  bild?: string | null;
  bildBeschreibung?: string | null;
}
const { titel, einordnung, einleitung, bild, bildBeschreibung } = Astro.props;
---
<section class="seitenkopf dunkel">
  <svg class="seitenkopf__bahn" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-40 420 C 520 400, 1000 260, 1520 -40" />
  </svg>
  <div class:list={['huelle', 'seitenkopf__raster', { 'mit-bild': bild }]}>
    <div>
      {einordnung && <p class="einordnung">{einordnung}</p>}
      <h1>{titel}</h1>
      {einleitung && <p class="einleitung">{einleitung}</p>}
      <slot />
    </div>
    {bild && <img src={bild} alt={bildBeschreibung ?? ''} />}
  </div>
</section>

<style>
  .seitenkopf {
    position: relative; overflow: hidden;
    background: var(--navy); color: var(--weiss);
    padding: clamp(2.5rem, 7vw, 4.5rem) 0 clamp(2.5rem, 6vw, 3.5rem);
  }
  .seitenkopf__bahn { position: absolute; inset: 0; width: 100%; height: 100%; }
  .seitenkopf__bahn path { fill: none; stroke: rgb(255 255 255 / 0.1); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .seitenkopf__raster { position: relative; display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .mit-bild { grid-template-columns: 1.2fr 1fr; gap: 3rem; } }
  h1 { margin-bottom: 0.6rem; }
  .einordnung {
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem;
    color: rgb(255 255 255 / 0.65); margin-bottom: 0.4rem;
  }
  .einleitung { font-size: 1.25rem; max-width: 36rem; color: rgb(255 255 255 / 0.82); margin: 0; }
  img { border-radius: 2px; }
</style>

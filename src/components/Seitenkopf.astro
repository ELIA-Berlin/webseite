---
/**
 * Dunkler Kopfbereich einer Unterseite mit Millimeterraster:
 * kleine Zeile, Überschrift, Einleitung, rechts optional ein Foto oder eine Skizze.
 * Ein Foto (bild) hat Vorrang; sonst wird die Skizze des Themas weiß auf dem Raster gezeigt.
 */
interface Props {
  titel: string;
  einordnung?: string | null;
  einleitung?: string | null;
  bild?: string | null;
  bildBeschreibung?: string | null;
  skizze?: string | null;
}
const { titel, einordnung, einleitung, bild, bildBeschreibung, skizze } = Astro.props;
const rechts = bild || skizze;
---
<section class="seitenkopf dunkel raster">
  <div class:list={['huelle', 'seitenkopf__raster', { 'mit-bild': rechts }]}>
    <div>
      {einordnung && <p class="einordnung">{einordnung}</p>}
      <h1>{titel}</h1>
      {einleitung && <p class="einleitung">{einleitung}</p>}
      <slot />
    </div>
    {bild
      ? <img class="foto" src={bild} alt={bildBeschreibung ?? ''} />
      : skizze && <img class="skizze" src={skizze} alt="" />}
  </div>
</section>

<style>
  .seitenkopf {
    --raster-y: -73px;
    color: var(--weiss);
    padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(3rem, 7vw, 4.5rem);
    border-bottom: 1px solid var(--navy);
  }
  .seitenkopf__raster { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .mit-bild { grid-template-columns: 1.3fr 1fr; gap: 3rem; } }
  h1 { margin-bottom: 0.8rem; }
  .einordnung {
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem;
    color: rgb(255 255 255 / 0.62); margin-bottom: 0.8rem;
  }
  .einleitung { font-size: 1.25rem; max-width: 36rem; color: rgb(255 255 255 / 0.82); margin: 0; }
  .foto { border-radius: 2px; }
  /* Linienzeichnung weiß einfärben, egal in welcher Farbe sie hochgeladen wurde */
  .skizze { width: min(100%, 24rem); justify-self: center; filter: brightness(0) invert(1); opacity: 0.9; }
</style>

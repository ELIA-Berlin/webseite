---
/**
 * Dunkler Kopfbereich einer Unterseite, gestaltet wie der obere Teil eines Zeichnungsblatts:
 * kleine Zeile, Überschrift, Einleitung, rechts optional ein Foto oder eine Skizze,
 * unten optional ein Schriftfeld mit Angaben zur Seite (z. B. Bereich, Wettbewerb).
 * Ein Foto (bild) hat Vorrang, dann ein 3D-Modell (modell); sonst wird die Skizze des Themas weiß auf dem Raster gezeigt.
 */
import Schriftfeld, { type Feld } from './Schriftfeld.astro';
import Modell3D from './Modell3D.astro';
interface Props {
  titel: string;
  einordnung?: string | null;
  einleitung?: string | null;
  bild?: string | null;
  bildBeschreibung?: string | null;
  skizze?: string | null;
  /** 3D-Modell statt der Skizze (Skizze bleibt als Ersatz) */
  modell?: 'stella' | 'doug' | null;
  schriftfeld?: Feld[];
}
const { titel, einordnung, einleitung, bild, bildBeschreibung, skizze, modell, schriftfeld = [] } = Astro.props;
const rechts = bild || skizze || modell;
const mitFeld = schriftfeld.some((f) => f.wert) || Astro.slots.has('feld');
---
<section class:list={['seitenkopf', 'dunkel', 'raster', 'leuchten', { 'mit-feld': mitFeld }]}>
  <div class:list={['huelle', 'seitenkopf__raster', { 'mit-bild': rechts }]}>
    <div class="seitenkopf__text">
      {einordnung && <p class="einordnung">{einordnung}</p>}
      <h1>{titel}</h1>
      {einleitung && <p class="einleitung">{einleitung}</p>}
      <slot />
    </div>
    {bild
      ? <img class="foto" src={bild} alt={bildBeschreibung ?? ''} />
      : modell
        ? <Modell3D modell={modell} skizze={skizze} beschreibung={`3D-Modell: ${titel}, schematisch`} />
        : skizze && <img class="skizze" src={skizze} alt="" />}
  </div>
  {mitFeld && (
    <div class="huelle seitenkopf__feld">
      <Schriftfeld felder={schriftfeld} dunkel>
        <slot name="feld" />
      </Schriftfeld>
    </div>
  )}
</section>

<style>
  .seitenkopf {
    --raster-y: -73px;
    color: var(--weiss);
    padding: clamp(3.5rem, 9vw, 6rem) 0 clamp(3rem, 7vw, 4.5rem);
  }
  .seitenkopf.mit-feld { padding-bottom: 0; }
  .seitenkopf__raster { display: grid; gap: 2rem; align-items: end; }
  @media (min-width: 56rem) { .mit-bild { grid-template-columns: 1.3fr 1fr; gap: 3rem; } }
  h1 { margin-bottom: 0; }
  .einordnung {
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem;
    color: rgb(255 255 255 / 0.62); margin-bottom: 0.9rem;
  }
  .einleitung { font-size: 1.3rem; line-height: 1.5; max-width: 34rem; color: rgb(255 255 255 / 0.84); margin: 1.2rem 0 0; }
  .foto { border-radius: 2px; }
  /* Linienzeichnung weiß einfärben, egal in welcher Farbe sie hochgeladen wurde */
  .skizze {
    width: min(100%, 26rem); justify-self: center; align-self: center;
    filter: brightness(0) invert(1) drop-shadow(0 0 6px rgb(200 225 245 / 0.55)); opacity: 0.92;
  }
  /* Das Schriftfeld sitzt am unteren Rand des Kopfes, wie auf einem Zeichnungsblatt */
  .seitenkopf__feld { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .seitenkopf__feld :global(.schriftfeld) { border-bottom: 0; }
  .seitenkopf__feld :global(.schriftfeld > div:last-child) { border-right-width: 1px; }
</style>

---
/**
 * Kopf der Startseite als Scroll-Szene: Beim Herunterscrollen bleibt der Kopf stehen
 * und die Rakete fliegt das Flugprofil ab – Start, Brennschluss, Apogäum, Fallschirm, Landung.
 * Danach geht die Seite normal weiter.
 *
 * Ohne JavaScript oder bei „Bewegung reduzieren“ steht der Kopf ganz normal da,
 * mit vollständig gezeichneter Flugbahn.
 *
 * Texte: src/content/startseite.yaml (Überschrift, Buttons) und → flugprofil (Beschriftungen).
 */
import Schriftfeld from './Schriftfeld.astro';

interface Props {
  start: {
    unterzeile?: string | null;
    titel: string;
    einleitung: string;
    knopfMitmachen: string;
    knopfThemen: string;
    flugprofil: { start: string; brennschluss: string; apogaeum: string; fallschirm: string; landung: string; beschreibung: string };
  };
}
const { start } = Astro.props;
const b = start.flugprofil;

// Flugbahn in drei Abschnitten. Punkte: Start (110|520), Brennschluss (300|250),
// Apogäum (640|70), Fallschirm (900|300), Landung (930|520).
const brenn = 'M110 520 C 135 420, 195 330, 300 250';
const gleit = 'M300 250 C 400 170, 510 78, 640 70';
const sink = 'M640 70 C 760 64, 860 150, 900 300 L 930 520';
const phasen = [b.start, b.brennschluss, b.apogaeum, b.fallschirm, b.landung];
---
<section class="flug dunkel raster" data-flugszene>
  <div class="flug__buehne leuchten">
    <svg class="flug__bahn" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid meet" role="img" aria-label={b.beschreibung}>
      <defs>
        <filter id="flug-glanz" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="6" result="weich" />
          <feMerge><feMergeNode in="weich" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <radialGradient id="flug-schein">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
          <stop offset="0.3" stop-color="#d6e8f7" stop-opacity="0.4" />
          <stop offset="1" stop-color="#d6e8f7" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="flug-flamme" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#d6e8f7" stop-opacity="0" />
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.9" />
        </linearGradient>
      </defs>

      <!-- Boden mit Schraffur, Startrampe, Maßlinie zum Apogäum -->
      <line class="boden" x1="40" y1="520" x2="980" y2="520" />
      <path class="schraffur" d="M70 520 l-14 16 M110 520 l-14 16 M150 520 l-14 16 M890 520 l-14 16 M930 520 l-14 16 M970 520 l-14 16" />
      <path class="rampe" d="M98 520 L104 470 M122 520 L116 470 M101 495 H119" />
      <line class="mass" x1="640" y1="70" x2="640" y2="520" />
      <path class="mass" d="M634 76 L640 70 L646 76 M634 514 L640 520 L646 514" />

      <!-- geplante Bahn, gestrichelt -->
      <g class="plan"><path d={brenn} /><path d={gleit} /><path d={sink} /></g>

      <!-- leuchtende Spur, wird mit dem Flug gezogen -->
      <g class="spur" filter="url(#flug-glanz)">
        <path class="spur-brenn" d={brenn} pathLength="1" />
        <path class="spur-gleit" d={gleit} pathLength="1" />
        <path class="spur-sink" d={sink} pathLength="1" />
      </g>

      <!-- Messpunkte -->
      <g class="punkt" data-i="0"><circle cx="110" cy="520" r="4.5" /><text x="110" y="556" text-anchor="middle">{b.start}</text></g>
      <g class="punkt" data-i="1"><circle cx="300" cy="250" r="4.5" /><path d="M300 250 L 330 280 H 350" /><text x="358" y="287">{b.brennschluss}</text></g>
      <g class="punkt" data-i="2"><circle cx="640" cy="70" r="4.5" /><path d="M640 70 V 34" /><text x="640" y="24" text-anchor="middle">{b.apogaeum}</text></g>
      <g class="punkt" data-i="3"><circle cx="900" cy="300" r="4.5" /><path d="M900 300 H 840" /><text x="830" y="306" text-anchor="end">{b.fallschirm}</text></g>
      <g class="punkt" data-i="4"><circle cx="930" cy="520" r="4.5" /><text x="930" y="556" text-anchor="middle">{b.landung}</text></g>

      <!-- Rakete: Flamme, Schein, Kern; Fallschirm erscheint beim Sinkflug -->
      <g class="rakete">
        <path class="flamme" d="M0 0 L -70 -5 L -70 5 Z" fill="url(#flug-flamme)" />
        <circle class="schein" r="34" fill="url(#flug-schein)" />
        <path class="schirm" d="M -16 -34 Q 0 -54 16 -34 M -16 -34 L 0 -4 M 16 -34 L 0 -4 M 0 -48 L 0 -4" />
        <circle class="kern" r="5" />
      </g>
    </svg>

    <div class="huelle flug__inhalt">
      <div class="flug__text">
        {start.unterzeile && <p class="unterzeile">{start.unterzeile}</p>}
        <h1>{start.titel}</h1>
        <p class="einleitung">{start.einleitung}</p>
        <p class="aktionen">
          <a class="knopf" href="/mitmachen">{start.knopfMitmachen}</a>
          <a class="knopf knopf--rahmen" href="/themen">{start.knopfThemen}</a>
        </p>
      </div>
      <div class="flug__feld">
        <Schriftfeld dunkel klein felder={[{ name: 'Fahrzeug', wert: 'Stella, schematisch' }]}>
          <div><dt>Flugphase</dt><dd data-phase aria-live="off">{b.landung}</dd></div>
          <div class="phasenleiste" aria-hidden="true">
            <dt>Ablauf</dt>
            <dd>{phasen.map((_, i) => <span data-stufe={i} />)}</dd>
          </div>
        </Schriftfeld>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Ruhezustand: normaler Kopf, Flugbahn ganz gezeichnet.
   * Mit Szene (Klasse .szene, setzt das Skript): Abschnitt wird höher, die Bühne bleibt stehen.
   */
  /* Das Raster hängt am Bildschirm, so läuft es nahtlos aus der Kopfzeile weiter und bleibt beim Flug ruhig */
  .flug { --raster-y: -1px; color: var(--weiss); position: relative; background-attachment: fixed; }
  .flug__buehne { position: relative; overflow: hidden; display: grid; }
  .flug.szene { height: 260vh; }
  .flug.szene .flug__buehne { position: sticky; top: 0; height: calc(100vh - 72px); height: calc(100svh - 72px); min-height: 34rem; }

  .flug__bahn {
    position: absolute; z-index: 0; pointer-events: none;
    right: max(0rem, calc((100vw - 92rem) / 2)); bottom: 5rem;
    width: min(62vw, 60rem); height: auto; overflow: visible;
  }
  .flug__inhalt {
    position: relative; z-index: 1; display: grid; align-content: space-between; gap: 2rem;
    padding-block: clamp(2.5rem, 8vh, 5rem) clamp(1.5rem, 4vh, 2.5rem);
  }
  .flug__text { max-width: 34rem; }
  .unterzeile {
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem;
    letter-spacing: 0.02em; color: rgb(255 255 255 / 0.62); margin-bottom: 1.4rem;
  }
  h1 { font-size: clamp(2.8rem, 1.2rem + 5.6vw, 6.4rem); }
  .einleitung { font-size: 1.25rem; max-width: 31rem; color: rgb(255 255 255 / 0.82); margin: 1.4rem 0 2rem; }
  .aktionen { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; }
  .flug__feld { max-width: 34rem; }

  .phasenleiste dd { display: flex; gap: 0.3rem; padding-top: 0.35rem; }
  .phasenleiste span { flex: 1; height: 3px; background: rgb(255 255 255 / 0.18); transition: background .3s, box-shadow .3s; }
  .phasenleiste span.an { background: #fff; box-shadow: 0 0 8px rgb(210 230 248 / 0.8); }

  /* Zeichnung */
  .boden { stroke: rgb(255 255 255 / 0.35); stroke-width: 1.2; }
  .schraffur, .rampe { fill: none; stroke: rgb(255 255 255 / 0.25); stroke-width: 1; }
  .rampe { stroke: rgb(255 255 255 / 0.5); }
  .mass { fill: none; stroke: rgb(255 255 255 / 0.16); stroke-width: 1; stroke-dasharray: 2 6; }
  .plan path { fill: none; stroke: rgb(255 255 255 / 0.32); stroke-width: 1.3; stroke-dasharray: 6 7; }
  .spur path { fill: none; stroke: #fff; stroke-linecap: round; }
  .spur-brenn { stroke-width: 3.2; }
  .spur-gleit { stroke-width: 2.2; }
  .spur-sink { stroke-width: 1.6; }
  .punkt circle { fill: var(--nacht); stroke: #fff; stroke-width: 1.5; transition: fill .35s; }
  .punkt path { fill: none; stroke: rgb(255 255 255 / 0.4); stroke-width: 1; }
  .punkt text { font-family: var(--schrift-titel); font-weight: 500; font-size: 20px; fill: rgb(255 255 255 / 0.62); transition: fill .35s; }
  .punkt.an circle { fill: #fff; filter: drop-shadow(0 0 6px rgb(210 230 248 / 0.9)); }
  .punkt.an text { fill: #fff; }
  .kern { fill: #fff; }
  .schirm { fill: none; stroke: #fff; stroke-width: 1.4; opacity: 0; }
  .flamme { opacity: 0; }

  /* Ruhezustand: Rakete gelandet, alles erreicht */
  .flug:not(.szene) .rakete { transform: translate(930px, 520px); }
  .flug:not(.szene) .punkt circle { fill: #fff; }
  .flug:not(.szene) .punkt text { fill: rgb(255 255 255 / 0.85); }
  .flug:not(.szene) .phasenleiste span { background: rgb(255 255 255 / 0.7); }

  /* Handy: Text oben, Flugbahn darunter */
  @media (max-width: 52rem) {
    .flug__bahn { position: relative; right: auto; bottom: auto; width: 100%; order: 2; margin: 2.4rem 0 0.4rem; }
    .flug__buehne { align-content: start; }
    .flug.szene .flug__buehne { display: flex; flex-direction: column; }
    .flug__inhalt { display: contents; }
    .flug__text { padding: clamp(1.8rem, 5vh, 3rem) max(16px, 5vw) 0; }
    .flug__feld { order: 3; padding: 0 max(16px, 5vw) 1.2rem; max-width: none; }
    .unterzeile { display: none; }
    .einleitung { font-size: 1.08rem; margin: 1rem 0 1.4rem; }
    .punkt text { font-size: 30px; }
  }
  @media (max-width: 52rem) and (max-height: 760px) {
    .einleitung { display: none; }
    .phasenleiste { display: none; }
  }
</style>

<script>
  /*
   * Scroll-Szene: Der Abschnitt ist 260 % der Bildschirmhöhe hoch, die Bühne klebt oben.
   * Der Scroll-Fortschritt durch den Abschnitt (0 bis 1) steuert den Flug. Die Rakete folgt
   * dem Fortschritt mit etwas Trägheit, damit es auch mit Mausrad ruhig aussieht.
   */
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-flugszene]').forEach((szene) => {
    if (ruhig.matches) return;
    const svg = szene.querySelector('svg')!;
    const q = <T extends Element>(s: string) => svg.querySelector<T>(s)!;
    const wege = ['.spur-brenn', '.spur-gleit', '.spur-sink'].map((s) => {
      const p = q<SVGPathElement>(s);
      return { p, laenge: p.getTotalLength() };
    });
    const rakete = q<SVGGElement>('.rakete');
    const schein = q<SVGCircleElement>('.schein');
    const flamme = q<SVGPathElement>('.flamme');
    const schirm = q<SVGPathElement>('.schirm');
    const punkte = [...svg.querySelectorAll<SVGGElement>('.punkt')];
    const phase = szene.querySelector<HTMLElement>('[data-phase]')!;
    const stufen = [...szene.querySelectorAll<HTMLElement>('[data-stufe]')];
    const namen = punkte.map((p) => p.querySelector('text')!.textContent ?? '');

    szene.classList.add('szene');

    // Abschnitte des Scroll-Fortschritts
    const A = { warten: 0.06, brenn: 0.3, gleit: 0.55, oben: 0.62, sink: 0.94 };
    const zwischen = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
    const beschleunigen = (t: number) => t * t;
    const abbremsen = (t: number) => 1 - (1 - t) * (1 - t);

    const spur = (i: number, anteil: number) => {
      const el = wege[i].p;
      el.style.strokeDasharray = '1 1';
      el.style.strokeDashoffset = String(1 - anteil);
    };
    const ort = (i: number, anteil: number) => {
      const { p, laenge } = wege[i];
      const a = p.getPointAtLength(laenge * anteil);
      const b = p.getPointAtLength(Math.min(laenge, laenge * anteil + 1));
      const c = p.getPointAtLength(Math.max(0, laenge * anteil - 1));
      return { x: a.x, y: a.y, winkel: (Math.atan2(b.y - c.y, b.x - c.x) * 180) / Math.PI };
    };

    let letzteStufe = -1;
    function zeichne(t: number) {
      const b = abbremsen(zwischen(t, A.warten, A.brenn));
      const brennAnteil = beschleunigen(zwischen(t, A.warten, A.brenn));
      const g = abbremsen(zwischen(t, A.brenn, A.gleit));
      const s = zwischen(t, A.oben, A.sink);

      spur(0, brennAnteil); spur(1, g); spur(2, s);

      let pos, stufe, glanz = 1, flammeAn = 0, schirmAn = 0;
      if (t < A.brenn) { pos = ort(0, brennAnteil); stufe = 0; glanz = 1 + b * 0.7; flammeAn = t > A.warten ? 1 : 0; }
      else if (t < A.gleit) { pos = ort(1, g); stufe = 1; glanz = 1.1 - g * 0.3; }
      else if (t < A.oben) { pos = ort(2, 0); stufe = 2; glanz = 0.8; }
      else { pos = ort(2, s); stufe = s > 0.62 ? 3 : 2; glanz = 0.75; schirmAn = s > 0.35 ? 1 : 0; }
      if (t >= A.sink) stufe = 4;

      rakete.setAttribute('transform', `translate(${pos.x} ${pos.y})`);
      flamme.setAttribute('transform', `rotate(${pos.winkel})`);
      flamme.style.opacity = String(flammeAn * (0.55 + 0.45 * (1 - b)));
      schein.setAttribute('r', String(34 * glanz));
      schirm.style.opacity = String(schirmAn);

      if (stufe !== letzteStufe) {
        letzteStufe = stufe;
        punkte.forEach((p, i) => p.classList.toggle('an', i <= stufe));
        stufen.forEach((st, i) => st.classList.toggle('an', i <= stufe));
        phase.textContent = namen[stufe];
      }
    }

    // Fortschritt aus der Scroll-Position, mit Trägheit
    let ziel = 0;
    let jetzt = 0;
    let laeuft = false;
    const messen = () => {
      const r = szene.getBoundingClientRect();
      const weg = r.height - window.innerHeight;
      ziel = weg > 0 ? Math.min(1, Math.max(0, -r.top / weg)) : 0;
      if (!laeuft) { laeuft = true; requestAnimationFrame(schritt); }
    };
    function schritt() {
      jetzt += (ziel - jetzt) * 0.12;
      if (Math.abs(ziel - jetzt) < 0.0005) jetzt = ziel;
      zeichne(jetzt);
      if (jetzt !== ziel) requestAnimationFrame(schritt);
      else laeuft = false;
    }
    window.addEventListener('scroll', messen, { passive: true });
    window.addEventListener('resize', messen);
    messen();
    jetzt = ziel;
    zeichne(jetzt);

    // Wer „Bewegung reduzieren“ später einschaltet, bekommt den ruhigen Kopf
    ruhig.addEventListener('change', () => { if (ruhig.matches) location.reload(); });
  });
</script>

---
/**
 * Ein Abschnitt mit Überschrift links und Inhalt rechts, getrennt durch eine Linie.
 * Ist der Abschnitt leer, zeigt er (nur in der Vorschau) einen Platzhalter, sonst nichts.
 */
import { zeigePlatzhalter } from '../lib/inhalte';
interface Props {
  titel?: string | null;
  leer?: boolean;
  /** Was hier später stehen soll, wird im Platzhalter angezeigt */
  platzhalter?: string;
  id?: string;
  grau?: boolean;
}
const { titel, leer = false, platzhalter, id, grau = false } = Astro.props;
const sichtbar = !leer || zeigePlatzhalter;
---
{sichtbar && (
  <section class:list={['abschnitt', { grau }]} id={id}>
    <div class="huelle zwei">
      <h2>{titel}</h2>
      <div class="inhalt">
        {leer ? <p class="platzhalter">Inhalt folgt{platzhalter && `: ${platzhalter}`}</p> : <slot />}
      </div>
    </div>
  </section>
)}

<style>
  .abschnitt { padding: clamp(3rem, 7vw, 5rem) 0; }
  .abschnitt + .abschnitt:not(.grau) .huelle { border-top: 1px solid var(--linie); padding-top: clamp(3rem, 7vw, 5rem); }
  .abschnitt + .abschnitt:not(.grau) { padding-top: 0; }
  .grau { background: var(--ring); }
  .zwei { display: grid; gap: 0.5rem 4rem; }
  @media (min-width: 48rem) { .zwei { grid-template-columns: 1fr 2fr; gap: 0.5rem 5rem; } }
  h2 { font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.6rem); }
  .inhalt { max-width: 42rem; }
  .inhalt > :global(:last-child) { margin-bottom: 0; }
  .platzhalter {
    border: 1.5px dashed var(--linie); border-radius: 4px; padding: 1rem 1.2rem;
    color: var(--grau); font-size: 1rem;
  }
</style>

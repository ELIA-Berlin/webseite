---
/**
 * Grundgerüst jeder Seite: Kopfbereich, Navigation, Fußzeile.
 * Einzelne Seiten übergeben Titel und Beschreibung für Browser-Tab und Suchmaschinen.
 */
import '../styles/global.css';
import { reader } from '../lib/inhalte';

interface Props {
  titel?: string;
  beschreibung?: string;
}

const {
  titel,
  beschreibung = 'ELIA ist die studentische Raumfahrtinitiative an der HTW Berlin und Nachwuchsgruppe der DGLR.',
} = Astro.props;

const seitentitel = titel ? `${titel} | ELIA` : 'ELIA – Studentische Raumfahrt an der HTW Berlin';
const kontakt = await reader.singletons.kontakt.read();

const navigation = [
  { href: '/projekte', text: 'Projekte' },
  { href: '/team', text: 'Team' },
  { href: '/sponsoren', text: 'Sponsoren' },
  { href: '/news', text: 'News' },
  { href: '/kontakt', text: 'Kontakt' },
];
const pfad = Astro.url.pathname.replace(/\/$/, '');
const istAktiv = (href: string) => pfad === href || pfad.startsWith(href + '/');
const jahr = new Date().getFullYear();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf">
      <div class="huelle kopf__zeile">
        <a href="/" class="marke" aria-label="ELIA – zur Startseite">
          <svg class="marke__zeichen" viewBox="0 0 32 32" aria-hidden="true">
            <ellipse cx="16" cy="16" rx="14" ry="6.5" transform="rotate(-28 16 16)" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="16" cy="16" r="4.5" fill="currentColor" />
            <circle cx="27.4" cy="9.6" r="2.4" fill="var(--zuendung)" />
          </svg>
          <span>ELIA</span>
        </a>

        <nav aria-label="Hauptnavigation">
          <details class="menue">
            <summary>Menü</summary>
            <ul>
              {navigation.map((punkt) => (
                <li>
                  <a href={punkt.href} aria-current={istAktiv(punkt.href) ? 'page' : undefined}>{punkt.text}</a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss">
      <div class="huelle fuss__raster">
        <div>
          <p class="fuss__marke">ELIA</p>
          <p>Studentische Raumfahrtinitiative an der HTW Berlin.<br />Nachwuchsgruppe der DGLR.</p>
        </div>
        <ul class="fuss__links">
          {kontakt?.email && <li><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></li>}
          {kontakt?.instagram && <li><a href={kontakt.instagram}>Instagram</a></li>}
          {kontakt?.linkedin && <li><a href={kontakt.linkedin}>LinkedIn</a></li>}
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
        </ul>
      </div>
      <p class="huelle fuss__klein">© {jahr} ELIA</p>
    </footer>
  </body>
</html>

<style>
  .kopf {
    background: var(--nacht);
    color: var(--weiss);
    position: relative;
    z-index: 5;
  }
  .kopf__zeile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
  }
  .marke {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .marke__zeichen { width: 2rem; height: 2rem; color: var(--weiss); }

  /* Navigation: auf großen Bildschirmen immer sichtbar, auf kleinen als aufklappbares Menü */
  .menue summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.95rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.5);
  }
  .menue summary::-webkit-details-marker { display: none; }
  .menue ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    position: absolute;
    left: 0; right: 0; top: 100%;
    background: var(--nacht);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .menue a {
    display: block;
    padding: 0.8rem var(--rand);
    text-decoration: none;
    font-size: 1.1rem;
  }
  .menue a[aria-current='page'] { color: var(--zuendung); }

  @media (min-width: 52rem) {
    .menue summary { display: none; }
    .menue ul {
      position: static;
      display: flex;
      gap: 0.4rem;
      padding: 0;
      border: 0;
      background: none;
    }
    .menue a {
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      font-size: 1rem;
    }
    .menue a:hover { background: rgb(255 255 255 / 0.1); }
    .menue a[aria-current='page'] { background: rgb(255 255 255 / 0.12); color: var(--weiss); }
  }

  .fuss {
    background: var(--nacht);
    color: rgb(255 255 255 / 0.85);
    padding-block: 3rem 1.5rem;
    font-size: 1rem;
  }
  .fuss__raster {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 40rem) {
    .fuss__raster { grid-template-columns: 1fr auto; align-items: start; }
  }
  .fuss__marke {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--weiss);
    margin-bottom: 0.4rem;
  }
  .fuss__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .fuss__klein { margin-top: 2.5rem; font-size: var(--s-klein); opacity: 0.7; }
</style>

<script>
  // Menü auf dem Desktop dauerhaft geöffnet halten, auf dem Handy nach Klick schließen.
  const menue = document.querySelector<HTMLDetailsElement>('.menue');
  const breit = window.matchMedia('(min-width: 52rem)');
  const anpassen = () => { if (menue) menue.open = breit.matches; };
  anpassen();
  breit.addEventListener('change', anpassen);
</script>

---
/**
 * Grundgerüst jeder Seite: Kopfzeile mit Navigation, Inhalt, Fußzeile.
 */
import '../styles/global.css';
import { allgemein, alleThemen, sichererLink } from '../lib/inhalte';
import Schriftfeld from '../components/Schriftfeld.astro';

interface Props {
  titel?: string;
  beschreibung?: string;
}
const {
  titel,
  beschreibung = 'ELIA ist die studentische Raumfahrtinitiative an der HTW Berlin und Nachwuchsgruppe der DGLR.',
} = Astro.props;
const seitentitel = titel ? `${titel} | ELIA` : 'ELIA – Studentische Raumfahrt aus Berlin';

// Menü, Fußzeile und Beschriftungen stehen in src/content/allgemein.yaml
// (Editor: „Menü, Fußzeile & Beschriftungen“). Ist das Menü leer, wird keins angezeigt.
const texte = await allgemein();
const navigation = texte.navigation;
// Untermenüs: unter „/themen“ automatisch alle Themen, sonst die Unterpunkte aus allgemein.yaml.
const themen = await alleThemen();
interface Unterpunkt { href: string; titel: string; zeile?: string | null; skizze?: string | null }
const unterpunkteVon = (punkt: (typeof navigation)[number]): Unterpunkt[] =>
  punkt.link === '/themen'
    ? themen.map(({ slug, entry }) => ({ href: `/themen/${slug}`, titel: entry.titel, zeile: entry.einordnung, skizze: entry.skizze }))
    : (punkt.unterpunkte ?? [])
        .filter((u) => u.text && sichererLink(u.link))
        .map((u) => ({ href: sichererLink(u.link)!, titel: u.text, zeile: u.zeile }));
const pfad = Astro.url.pathname.replace(/\/$/, '');
const aktiv = (link: string) => pfad === link || pfad.startsWith(`${link}/`);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Sicherheitsregeln (Content-Security-Policy): Die Seite lädt nur eigene Dateien.
      Wer später Videos, Karten oder externe Bilder einbindet, muss sie hier erlauben
      und die Datenschutzerklärung ergänzen. 'unsafe-inline' ist nötig, weil Astro
      kleine Skripte und Styles direkt ins HTML schreibt.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf dunkel raster">
      <div class="huelle kopf__zeile">
        <a class="marke" href="/">
          <img src="/logo.png" alt="" width="42" height="42" />
          <span>ELIA</span>
        </a>
        {navigation.length > 0 && (
        <nav aria-label="Hauptnavigation">
          <details class="menue">
            <summary>{texte.menueKnopf}</summary>
            <ul>
              {navigation.map((punkt, nr) => {
                const unter = unterpunkteVon(punkt);
                const id = `untermenue-${nr}`;
                return unter.length > 0 ? (
                  <li class="mit-unter">
                    <span class="unter__zeile">
                      <a href={sichererLink(punkt.link)} aria-current={pfad === punkt.link ? 'page' : undefined} class:list={{ teil: pfad.startsWith(`${punkt.link}/`) }}>{punkt.text}</a>
                      <button class="unter__knopf" type="button" aria-expanded="false" aria-controls={id}>
                        <span class="sr">{texte.menueUnterKnopf || 'Untermenü'}: {punkt.text}</span>
                        <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 L6 6.5 L11 1.5" /></svg>
                      </button>
                    </span>
                    <ul class="unter" id={id}>
                      {unter.map((u) => (
                        <li>
                          <a href={u.href} aria-current={pfad === u.href ? 'page' : undefined}>
                            {u.skizze !== undefined && <span class="unter__skizze">{u.skizze && <img src={u.skizze} alt="" width="48" height="32" />}</span>}
                            <span class="unter__text">
                              <span class="unter__titel">{u.titel}</span>
                              {u.zeile && <span class="unter__einordnung">{u.zeile}</span>}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li><a href={sichererLink(punkt.link)} aria-current={aktiv(punkt.link) ? 'page' : undefined}>{punkt.text}</a></li>
                );
              })}
            </ul>
          </details>
        </nav>
        )}
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss raster">
      <div class="huelle fuss__raster">
        <div class="fuss__marke">
          <img src="/logo.png" alt="" width="64" height="64" loading="lazy" />
          <div>
            <p class="fuss__name">ELIA</p>
            {texte.fussText && <p class="fuss__text">{texte.fussText}</p>}
          </div>
        </div>
        <Schriftfeld
          dunkel
          felder={[
            ...(texte.fussFelder ?? []),
            { name: texte.fussKontakt || 'Kontakt', wert: texte.kontaktEmail, link: `mailto:${texte.kontaktEmail}` },
          ]}
        >
          <div>
            <dt>{texte.fussRechtliches || 'Rechtliches'}</dt>
            <dd class="fuss__recht"><a href="/impressum">{texte.fussImpressum}</a> <a href="/datenschutz">{texte.fussDatenschutz}</a></dd>
          </div>
        </Schriftfeld>
      </div>
    </footer>
  </body>
</html>

<style>
  .kopf { color: var(--weiss); border-bottom: 1px solid rgb(255 255 255 / 0.14); position: relative; z-index: 5; }
  /* genau 72 px hoch (3 Rasterkästchen), damit das Raster im Seitenkopf darunter weiterläuft */
  .kopf__zeile { display: flex; align-items: center; justify-content: space-between; height: 71px; }
  .marke {
    display: inline-flex; align-items: center; gap: 0.7rem;
    font-family: var(--schrift-titel); font-weight: 700; font-size: 1.45rem; letter-spacing: 0.06em;
    text-decoration: none;
  }
  .marke img { width: 2.6rem; height: 2.6rem; }

  .menue summary {
    list-style: none; cursor: pointer;
    font-family: var(--schrift-titel); font-weight: 600; font-size: 1.05rem;
    padding: 0.45rem 0.9rem; border-radius: 4px; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.5);
  }
  .menue summary::-webkit-details-marker { display: none; }
  .menue ul { list-style: none; margin: 0; padding: 0; }
  .menue > ul {
    padding: 0.5rem 0;
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--nacht); border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .menue > ul > li > a, .unter__zeile > a {
    display: block; padding: 0.75rem var(--rand);
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem; text-decoration: none;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Untermenü Themen: auf dem Handy immer ausgeklappt und eingerückt */
  .unter__zeile { display: flex; align-items: center; }
  .unter__knopf { display: none; }
  .menue .unter { padding: 0 var(--rand) 0.4rem calc(var(--rand) + 0.9rem); }
  .unter a { display: flex; align-items: center; gap: 0.8rem; padding: 0.45rem 0; text-decoration: none; }
  .unter__skizze { display: grid; place-items: center; width: 3rem; height: 2rem; flex: none; }
  .unter__skizze img { max-width: 100%; max-height: 100%; width: auto; height: auto; filter: brightness(0) invert(1); opacity: 0.85; }
  .unter__text { display: grid; line-height: 1.2; }
  .unter__titel { font-family: var(--schrift-titel); font-weight: 600; font-size: 1.1rem; }
  .unter__einordnung { font-size: 0.85rem; color: rgb(255 255 255 / 0.58); }
  .unter a[aria-current='page'] .unter__titel { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }

  @media (min-width: 52rem) {
    .menue summary { display: none; }
    .menue > ul { position: static; display: flex; align-items: center; gap: 2rem; padding: 0; border: 0; background: none; }
    .menue > ul > li > a, .unter__zeile > a { padding: 0.3rem 0; font-size: 1.05rem; opacity: 0.85; }
    .menue > ul > li > a:hover, .unter__zeile > a:hover { opacity: 1; text-decoration: underline; }
    .menue > ul > li > a[aria-current='page'], .unter__zeile > a[aria-current='page'], .unter__zeile > a.teil {
      opacity: 1; text-decoration: underline; text-decoration-thickness: 2px;
    }

    /* Untermenü als Tafel unter „Themen“: öffnet bei Maus, Tastatur oder Klick auf den Pfeil */
    .mit-unter { position: relative; }
    .unter__knopf {
      display: grid; place-items: center; width: 1.6rem; height: 1.6rem; margin-left: 0.15rem;
      background: none; border: 0; border-radius: 3px; color: inherit; cursor: pointer; opacity: 0.85;
    }
    .unter__knopf svg { width: 0.7rem; fill: none; stroke: currentColor; stroke-width: 1.6; }
    .unter__knopf:hover { opacity: 1; background: rgb(255 255 255 / 0.08); }
    .menue .unter {
      display: none;
      position: absolute; top: calc(100% + 0.9rem); left: -1rem; z-index: 10;
      min-width: 19rem; padding: 0.5rem;
      background: var(--nacht); border: 1px solid rgb(255 255 255 / 0.22);
      box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
    }
    /* unsichtbare Brücke, damit die Maus auf dem Weg zur Tafel das Menü nicht schließt */
    .unter::before { content: ''; position: absolute; left: 0; right: 0; top: -1rem; height: 1rem; }
    .mit-unter:hover .unter, .mit-unter:focus-within .unter, .mit-unter[data-offen] .unter { display: block; }
    .mit-unter[data-zu] .unter { display: none; }
    .mit-unter[data-offen] .unter__knopf svg, .mit-unter:hover .unter__knopf svg { transform: rotate(180deg); }
    .unter a { padding: 0.55rem 0.7rem; border-radius: 3px; }
    .unter a:hover, .unter a:focus-visible { background: rgb(255 255 255 / 0.07); }
    .unter a:hover .unter__titel { text-decoration: underline; text-underline-offset: 0.2em; }
  }

  .fuss { --raster-y: -1px; color: var(--weiss); padding: clamp(3rem, 7vw, 4.5rem) 0 clamp(2.5rem, 6vw, 3.5rem); border-top: 1px solid rgb(255 255 255 / 0.14); }
  .fuss__raster { display: grid; gap: 2rem; }
  .fuss__raster :global(.schriftfeld) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .fuss__marke { display: flex; gap: 1rem; align-items: center; }
  .fuss__marke img { width: 4rem; height: 4rem; flex: none; }
  .fuss__marke p { margin: 0; }
  .fuss__name { font-family: var(--schrift-titel); font-weight: 700; font-size: 1.6rem; letter-spacing: 0.06em; line-height: 1.1; }
  .fuss__text { color: rgb(255 255 255 / 0.62); font-size: 0.95rem; line-height: 1.4; max-width: 16rem; }
  .fuss__recht { display: flex; flex-wrap: wrap; gap: 0 1rem; }
</style>

<script>
  // Auf großen Bildschirmen ist das Menü immer offen, auf Handys klappt es auf.
  const menue = document.querySelector<HTMLDetailsElement>('.menue');
  const breit = window.matchMedia('(min-width: 52rem)');
  const anpassen = () => { if (menue) menue.open = breit.matches; };
  anpassen();
  breit.addEventListener('change', anpassen);

  // Untermenü „Themen“: Pfeil öffnet und schließt per Klick, Escape schließt.
  for (const eintrag of document.querySelectorAll<HTMLElement>('.mit-unter')) {
    const knopf = eintrag.querySelector<HTMLButtonElement>('.unter__knopf');
    if (!knopf) continue;
    const setzen = (offen: boolean) => {
      knopf.setAttribute('aria-expanded', String(offen));
      eintrag.toggleAttribute('data-offen', offen);
      eintrag.toggleAttribute('data-zu', !offen);
    };
    knopf.addEventListener('click', () => setzen(knopf.getAttribute('aria-expanded') !== 'true'));
    eintrag.addEventListener('mouseleave', () => eintrag.removeAttribute('data-zu'));
    eintrag.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { setzen(false); knopf.focus(); }
    });
    document.addEventListener('click', (e) => {
      if (!eintrag.contains(e.target as Node) && eintrag.hasAttribute('data-offen')) setzen(false);
    });
  }
</script>

---
/**
 * Grundgerüst jeder Seite: Kopfzeile mit Navigation, Inhalt, Fußzeile.
 */
import '../styles/global.css';
import { allgemein } from '../lib/inhalte';

interface Props {
  titel?: string;
  beschreibung?: string;
}
const {
  titel,
  beschreibung = 'ELIA ist die studentische Raumfahrtinitiative an der HTW Berlin und Nachwuchsgruppe der DGLR.',
} = Astro.props;
const seitentitel = titel ? `${titel} | ELIA` : 'ELIA – Studentische Raumfahrt aus Berlin';

// Menü, Fußzeile und Beschriftungen stehen in src/content/allgemein.yaml
// (Editor: „Menü, Fußzeile & Beschriftungen“). Ist das Menü leer, wird keins angezeigt.
const texte = await allgemein();
const navigation = texte.navigation;
const pfad = Astro.url.pathname.replace(/\/$/, '');
const aktiv = (link: string) => pfad === link || pfad.startsWith(`${link}/`);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf dunkel raster">
      <div class="huelle kopf__zeile">
        <a class="marke" href="/">
          <img src="/logo.png" alt="" width="42" height="42" />
          <span>ELIA</span>
        </a>
        {navigation.length > 0 && (
        <nav aria-label="Hauptnavigation">
          <details class="menue">
            <summary>{texte.menueKnopf}</summary>
            <ul>
              {navigation.map((punkt) => (
                <li><a href={punkt.link} aria-current={aktiv(punkt.link) ? 'page' : undefined}>{punkt.text}</a></li>
              ))}
            </ul>
          </details>
        </nav>
        )}
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss">
      <div class="huelle fuss__zeile">
        <span>{texte.fussText}</span>
        <span class="fuss__links">
          <a href={`mailto:${texte.kontaktEmail}`}>{texte.kontaktEmail}</a>
          <a href="/impressum">{texte.fussImpressum}</a>
          <a href="/datenschutz">{texte.fussDatenschutz}</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .kopf { color: var(--weiss); border-bottom: 1px solid rgb(255 255 255 / 0.14); position: relative; z-index: 5; }
  /* genau 72 px hoch (3 Rasterkästchen), damit das Raster im Seitenkopf darunter weiterläuft */
  .kopf__zeile { display: flex; align-items: center; justify-content: space-between; height: 71px; }
  .marke {
    display: inline-flex; align-items: center; gap: 0.7rem;
    font-family: var(--schrift-titel); font-weight: 700; font-size: 1.45rem; letter-spacing: 0.06em;
    text-decoration: none;
  }
  .marke img { width: 2.6rem; height: 2.6rem; }

  .menue summary {
    list-style: none; cursor: pointer;
    font-family: var(--schrift-titel); font-weight: 600; font-size: 1.05rem;
    padding: 0.45rem 0.9rem; border-radius: 4px; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.5);
  }
  .menue summary::-webkit-details-marker { display: none; }
  .menue ul {
    list-style: none; margin: 0; padding: 0.5rem 0;
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--nacht); border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .menue a {
    display: block; padding: 0.75rem var(--rand);
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem; text-decoration: none;
  }

  @media (min-width: 52rem) {
    .menue summary { display: none; }
    .menue ul { position: static; display: flex; gap: 2rem; padding: 0; border: 0; background: none; }
    .menue a { padding: 0.3rem 0; font-size: 1.05rem; opacity: 0.85; }
    .menue a:hover { opacity: 1; text-decoration: underline; }
    .menue a[aria-current='page'] { opacity: 1; text-decoration: underline; text-decoration-thickness: 2px; }
  }

  .fuss { background: var(--nacht-tief); color: rgb(255 255 255 / 0.7); padding: 2.2rem 0; font-size: 0.95rem; }
  .fuss__zeile { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .fuss__links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
</style>

<script>
  // Auf großen Bildschirmen ist das Menü immer offen, auf Handys klappt es auf.
  const menue = document.querySelector<HTMLDetailsElement>('.menue');
  const breit = window.matchMedia('(min-width: 52rem)');
  const anpassen = () => { if (menue) menue.open = breit.matches; };
  anpassen();
  breit.addEventListener('change', anpassen);
</script>

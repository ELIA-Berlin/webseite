---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { reader } from '../lib/inhalte';

const kontakt = await reader.singletons.kontakt.read();
---
<Basis titel="Kontakt" beschreibung="So erreichst du ELIA.">
  <Seitenkopf titel="Kontakt" einleitung={kontakt?.hinweis} />
  <section class="abschnitt huelle raster">
    <div>
      <h2>E-Mail</h2>
      {kontakt?.email
        ? <p><a class="mail" href={`mailto:${kontakt.email}`}>{kontakt.email}</a></p>
        : <p class="leise">Die E-Mail-Adresse wird gerade eingerichtet.</p>}
    </div>
    <div>
      <h2>Anschrift</h2>
      <p class="anschrift">{kontakt?.anschrift}</p>
    </div>
    {(kontakt?.instagram || kontakt?.linkedin) && (
      <div>
        <h2>Social Media</h2>
        <ul class="social">
          {kontakt?.instagram && <li><a href={kontakt.instagram}>Instagram</a></li>}
          {kontakt?.linkedin && <li><a href={kontakt.linkedin}>LinkedIn</a></li>}
        </ul>
      </div>
    )}
  </section>
</Basis>

<style>
  .raster { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  h2 { font-size: var(--s-h4); }
  .mail { font-family: var(--font-display); font-size: 1.15rem; word-break: break-word; }
  .anschrift { white-space: pre-line; }
  .social { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
</style>

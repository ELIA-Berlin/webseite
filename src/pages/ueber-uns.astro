---
/** Über uns. Texte: src/content/seiten/ueber-uns.yaml, Vorstand: Sammlung „Personen“ */
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Absaetze from '../components/Absaetze.astro';
import Missionslog from '../components/Missionslog.astro';
import Platzhalter from '../components/Platzhalter.astro';
import { absaetze, reader } from '../lib/inhalte';

const seite = await reader.singletons.ueberUns.readOrThrow();
const vorstand = (await reader.collections.personen.all())
  .filter((p) => p.entry.vorstand)
  .sort((a, b) => (a.entry.reihenfolge ?? 99) - (b.entry.reihenfolge ?? 99));
const leer = (text?: string | null) => absaetze(text).length === 0;
---
<Basis titel={seite.titel}>
  <Seitenkopf titel={seite.titel} einleitung={seite.einleitung} />

  <Abschnitt titel={seite.werWirSindTitel} leer={leer(seite.werWirSindText)} platzhalter="wer wir sind, was der Name ELIA bedeutet">
    <Absaetze text={seite.werWirSindText} />
  </Abschnitt>

  {seite.rueckblick.length > 0
    ? <Missionslog titel={seite.rueckblickTitel} eintraege={seite.rueckblick} />
    : <div class="huelle"><Platzhalter text="Missionslog: Gründung Ende 2025 und weitere Meilensteine" /></div>}

  <Abschnitt titel={seite.einordnungTitel} leer={leer(seite.einordnungText)} platzhalter="DGLR-Nachwuchsgruppe, HTW Berlin, eingetragener Verein">
    <Absaetze text={seite.einordnungText} />
  </Abschnitt>

  <Abschnitt titel={seite.vorstandTitel} leer={vorstand.length === 0} platzhalter="Personen mit Häkchen „Gehört zum Vorstand“" grau>
    <ul class="personen">
      {vorstand.map(({ entry }) => (
        <li>
          {entry.foto && <img src={entry.foto} alt="" width="160" height="160" loading="lazy" />}
          <p class="name">{entry.name}</p>
          {entry.rolle && <p>{entry.rolle}</p>}
        </li>
      ))}
    </ul>
  </Abschnitt>
</Basis>

<style>
  .personen { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 1.6rem; }
  .personen img { width: 100%; aspect-ratio: 1; object-fit: cover; margin-bottom: 0.7rem; }
  .personen p { margin: 0; color: var(--grau); font-size: 1rem; }
  .personen .name { font-family: var(--schrift-titel); font-weight: 600; font-size: 1.25rem; color: var(--navy); }
</style>

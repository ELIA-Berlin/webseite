---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { team } from '../lib/inhalte';

const alle = await team();
const bereiche = [
  { wert: 'vorstand', titel: 'Vorstand' },
  { wert: 'leitung', titel: 'Teamleitungen' },
  { wert: 'mitglied', titel: 'Mitglieder' },
  { wert: 'beratend', titel: 'Beratende Mitglieder' },
]
  .map((b) => ({ ...b, personen: alle.filter((p) => p.entry.bereich === b.wert) }))
  .filter((b) => b.personen.length > 0);

const initialen = (name: string) =>
  name.split(/\s+/).map((teil) => teil[0]).slice(0, 2).join('').toUpperCase();
---
<Basis titel="Team" beschreibung="Die Menschen hinter ELIA.">
  <Seitenkopf
    titel="Team"
    einleitung="Bei ELIA arbeiten Studierende aus Ingenieurwesen, Informatik, Wirtschaft und Recht zusammen."
  />
  {bereiche.map((bereich) => (
    <section class="abschnitt huelle">
      <h2>{bereich.titel}</h2>
      <ul class="personen">
        {bereich.personen.map(({ entry }) => (
          <li class="person">
            {entry.foto
              ? <img src={entry.foto} alt="" loading="lazy" />
              : <span class="person__initialen" aria-hidden="true">{initialen(entry.name)}</span>}
            <h3>{entry.name}</h3>
            {entry.rolle && <p class="person__rolle">{entry.rolle}</p>}
            {entry.studiengang && <p class="leise">{entry.studiengang}</p>}
            {entry.linkedin && <a href={entry.linkedin}>LinkedIn-Profil von {entry.name}</a>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Basis>

<style>
  .personen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
  }
  .person img, .person__initialen {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
    max-width: 11rem;
  }
  .person__initialen {
    display: grid;
    place-items: center;
    background: var(--nacht);
    color: var(--weiss);
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 600;
  }
  .person h3 { font-size: var(--s-h4); margin: 0 0 0.2rem; }
  .person p { margin: 0; }
  .person__rolle { font-weight: 700; }
  .person a { font-size: var(--s-klein); }
</style>

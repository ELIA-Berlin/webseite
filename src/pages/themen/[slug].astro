---
/**
 * Vorlage für alle Themenseiten (Rover, Rakete, Space Law, Entrepreneurship).
 * Inhalte: src/content/themen/<thema>.yaml, im Editor unter „Themen“.
 * Optionale Abschnitte (Wettbewerb, Technik, Formate) erscheinen nur, wenn sie ausgefüllt sind.
 */
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Abschnitt from '../../components/Abschnitt.astro';
import Absaetze from '../../components/Absaetze.astro';
import NewsListe from '../../components/NewsListe.astro';
import { absaetze, allgemein, alleNews, alleThemen, reader, zeigePlatzhalter } from '../../lib/inhalte';

export async function getStaticPaths() {
  const themen = await alleThemen();
  return themen.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const thema = await reader.collections.themen.readOrThrow(slug!);
const texte = await allgemein();
const person = thema.ansprechperson ? await reader.collections.personen.read(thema.ansprechperson) : null;
const news = (await alleNews()).filter((n) => n.entry.thema === slug).slice(0, 3);
const themenNamen = { [slug!]: thema.titel };

const leer = (text?: string | null) => absaetze(text).length === 0;
const wettbewerb = thema.wettbewerb.discriminant ? thema.wettbewerb.value : null;
const technikDa = Boolean(thema.technik.titel);
---
<Basis titel={thema.titel} beschreibung={thema.einzeiler || undefined}>
  <Seitenkopf
    titel={thema.titel}
    einordnung={thema.einordnung}
    einleitung={thema.einzeiler || (zeigePlatzhalter ? 'Inhalt folgt: Einzeiler' : null)}
    bild={thema.bild}
    bildBeschreibung={thema.bildBeschreibung}
  />

  <Abschnitt titel={texte.themaWorumEsGeht} leer={leer(thema.worumEsGeht)} platzhalter="Worum geht es in diesem Thema?">
    <Absaetze text={thema.worumEsGeht} />
  </Abschnitt>

  {wettbewerb && (
    <Abschnitt titel={wettbewerb.name || texte.themaWettbewerb} leer={leer(wettbewerb.text)} platzhalter="Was ist der Wettbewerb, was ist unser Ziel?">
      <Absaetze text={wettbewerb.text} />
      {wettbewerb.link && <p><a href={wettbewerb.link}>{wettbewerb.name || texte.themaWettbewerb} ↗</a></p>}
    </Abschnitt>
  )}

  <Abschnitt titel={texte.themaStand} leer={leer(thema.stand) && thema.meilensteine.length === 0} platzhalter="Wo stehen wir, mit Meilensteinen">
    <Absaetze text={thema.stand} />
    {thema.meilensteine.length > 0 && (
      <ol class="meilensteine">
        {thema.meilensteine.map((m) => (
          <li class:list={{ erreicht: m.erreicht }}>
            <span class="zeitpunkt">{m.zeitpunkt}</span>
            <span>{m.text}</span>
          </li>
        ))}
      </ol>
    )}
  </Abschnitt>

  {technikDa && (
    <Abschnitt titel={thema.technik.titel} leer={leer(thema.technik.text) && !thema.technik.bild} platzhalter="Technik oder Vertiefung, z. B. eine Zeichnung">
      <Absaetze text={thema.technik.text} />
      {thema.technik.bild && <img src={thema.technik.bild} alt={thema.technik.bildBeschreibung} loading="lazy" />}
    </Abschnitt>
  )}

  {thema.formate.length > 0 && (
    <Abschnitt titel={texte.themaFormate}>
      <ul class="formate">
        {thema.formate.map((f) => <li><h3>{f.titel}</h3><p>{f.text}</p></li>)}
      </ul>
    </Abschnitt>
  )}

  <section class="mitmachen">
    <div class="huelle zwei">
      <div>
        <h2>{texte.themaWenWirSuchen}</h2>
        {leer(thema.wenWirSuchen)
          ? zeigePlatzhalter && <p class="platzhalter">Inhalt folgt: welche Leute wir für dieses Thema suchen</p>
          : <Absaetze text={thema.wenWirSuchen} />}
        <a class="knopf" href="/mitmachen">{texte.zumMitmachen}</a>
      </div>
      <div>
        <h2>{texte.themaAnsprechperson}</h2>
        {person ? (
          <div class="person">
            {person.foto && <img src={person.foto} alt="" width="96" height="96" />}
            <div>
              <p class="name">{person.name}</p>
              {person.rolle && <p>{person.rolle}</p>}
              <p><a href={`mailto:${person.email || texte.kontaktEmail}`}>{person.email || texte.kontaktEmail}</a></p>
            </div>
          </div>
        ) : (
          <>
            {zeigePlatzhalter && <p class="platzhalter">Inhalt folgt: Person aus der Sammlung „Personen“</p>}
            <p><a href={`mailto:${texte.kontaktEmail}`}>{texte.kontaktEmail}</a></p>
          </>
        )}
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="abschnitt-news">
      <div class="huelle">
        <h2>{texte.themaNews}</h2>
        <NewsListe eintraege={news} themenNamen={themenNamen} />
        <p class="alle"><a href={`/news?thema=${slug}`}>{texte.mehrNews} →</a></p>
      </div>
    </section>
  )}
</Basis>

<style>
  .meilensteine { list-style: none; margin: 1.5rem 0 0; padding: 0; }
  .meilensteine li {
    position: relative; display: grid; gap: 0.1rem 1.2rem;
    padding: 0 0 1.2rem 1.8rem; border-left: 1.5px solid var(--linie); margin-left: 0.4rem;
  }
  .meilensteine li:last-child { border-left-color: transparent; padding-bottom: 0; }
  .meilensteine li::before {
    content: ''; position: absolute; left: -0.45rem; top: 0.35rem;
    width: 0.8rem; height: 0.8rem; border-radius: 50%;
    background: var(--weiss); box-shadow: inset 0 0 0 2px var(--navy);
  }
  .meilensteine li.erreicht::before { background: var(--navy); }
  .zeitpunkt { font-family: var(--schrift-titel); font-weight: 600; }
  @media (min-width: 40rem) { .meilensteine li { grid-template-columns: 9rem 1fr; } }

  .formate { list-style: none; margin: 0; padding: 0; }
  .formate li + li { border-top: 1px solid var(--linie); padding-top: 1.2rem; margin-top: 1.2rem; }
  .formate h3 { margin-bottom: 0.3rem; }
  .formate p { margin: 0; color: var(--grau); }

  .mitmachen { background: var(--ring); padding: clamp(2.5rem, 6vw, 4rem) 0; }
  .zwei { display: grid; gap: 2.5rem 4rem; }
  @media (min-width: 48rem) { .zwei { grid-template-columns: 1.4fr 1fr; } }
  .mitmachen h2 { font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.2rem); }
  .person { display: flex; gap: 1.2rem; align-items: flex-start; }
  .person img { width: 6rem; height: 6rem; object-fit: cover; border-radius: 50%; }
  .person p { margin: 0 0 0.2rem; }
  .name { font-family: var(--schrift-titel); font-weight: 600; font-size: 1.3rem; }
  .platzhalter { border: 1.5px dashed var(--linie); border-radius: 4px; padding: 1rem 1.2rem; color: var(--grau); font-size: 1rem; }

  .abschnitt-news { padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(3.5rem, 8vw, 5rem); }
  .abschnitt-news h2 { font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.2rem); }
  .alle { margin-top: 1.2rem; font-family: var(--schrift-titel); font-weight: 600; }
</style>

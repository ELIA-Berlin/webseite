---
/**
 * Themenübersicht: jedes Thema als große Zeile mit Skizze, Text und Schriftfeld.
 * Texte: src/content/seiten/themen.yaml, Themen: src/content/themen/
 */
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Absaetze from '../../components/Absaetze.astro';
import Platzhalter from '../../components/Platzhalter.astro';
import Schriftfeld from '../../components/Schriftfeld.astro';
import { absaetze, allgemein, alleThemen, reader } from '../../lib/inhalte';

const seite = await reader.singletons.themenSeite.readOrThrow();
const texte = await allgemein();
const themen = await alleThemen();
const einleitungDa = absaetze(seite.einleitung).length > 0;
---
<Basis titel={seite.titel}>
  <Seitenkopf titel={seite.titel} />

  <section class="themen">
    <div class="huelle">
      {einleitungDa
        ? <div class="einleitung"><Absaetze text={seite.einleitung} /></div>
        : <Platzhalter text="Einleitung: wie die vier Themen zusammenhängen" />}

      <ul class="zeilen">
        {themen.map(({ slug, entry }) => (
          <li class="zeile">
            <a class="skizze raster-hell" href={`/themen/${slug}`} tabindex="-1" aria-hidden="true">
              {entry.skizze && <img src={entry.skizze} alt="" loading="lazy" />}
            </a>
            <div class="text">
              <h2><a href={`/themen/${slug}`}>{entry.titel}</a></h2>
              {entry.teaser ? <p>{entry.teaser}</p> : entry.kurztext ? <p>{entry.kurztext}</p> : <Platzhalter text="zwei bis drei Sätze zum Thema" />}
              <Schriftfeld
                klein
                felder={[
                  { name: texte.themaBereich || 'Bereich', wert: entry.wettbewerb.discriminant && entry.wettbewerb.value.name === entry.einordnung ? null : entry.einordnung },
                  { name: texte.themaWettbewerb, wert: entry.wettbewerb.discriminant ? entry.wettbewerb.value.name : null },
                ]}
              />
              <a class="knopf knopf--rahmen" href={`/themen/${slug}`}>{texte.mehrErfahren} {entry.titel}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Basis>

<style>
  .themen { padding: clamp(3rem, 7vw, 5rem) 0 clamp(4rem, 9vw, 7rem); }
  .einleitung { max-width: 40rem; margin-bottom: 3rem; font-size: 1.3rem; line-height: 1.5; }
  .zeilen { list-style: none; margin: 0; padding: 0; }
  .zeile { display: grid; gap: 1.5rem 3.5rem; padding: 2.5rem 0; border-top: 1px solid var(--linie); }
  .zeile:first-child { border-top: 1.5px solid var(--navy); }
  @media (min-width: 52rem) {
    .zeile { grid-template-columns: 5fr 7fr; align-items: center; padding: 3rem 0; }
  }
  .skizze { display: grid; place-items: center; aspect-ratio: 3 / 2; border: 1.5px solid var(--navy); }
  .skizze img { max-height: 68%; max-width: 72%; width: auto; height: auto; }
  .skizze:hover { background-color: var(--ring-tief); }
  h2 { font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem); margin: 0 0 0.8rem; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.1em; }
  .text p { color: var(--grau); max-width: 36rem; margin-bottom: 1.4rem; }
  .text :global(.schriftfeld) { max-width: 32rem; margin-bottom: 1.6rem; }
  .knopf { font-size: 1rem; padding: 0.65rem 1.2rem; }
</style>

---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import { reader, alsHtml, formatDatum } from '../../lib/inhalte';

export async function getStaticPaths() {
  const slugs = await reader.collections.news.list();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const beitrag = await reader.collections.news.read(slug!);
if (!beitrag) return Astro.redirect('/404');
const html = await alsHtml(beitrag.inhalt);
---
<Basis titel={beitrag.titel} beschreibung={beitrag.zusammenfassung}>
  <Seitenkopf titel={beitrag.titel}>
    <a slot="ueber" class="zurueck" href="/news">Alle News</a>
    <p class="datum"><time datetime={beitrag.datum}>{formatDatum(beitrag.datum)}</time></p>
  </Seitenkopf>

  <article class="abschnitt huelle">
    {beitrag.bild && <img class="titelbild" src={beitrag.bild} alt={beitrag.bildAlt || ''} />}
    <p class="vorspann lesetext">{beitrag.zusammenfassung}</p>
    <div class="prosa" set:html={html} />
  </article>
</Basis>

<style>
  .zurueck { display: inline-block; margin-bottom: 1.2rem; color: var(--himmel); }
  .datum { margin: 0; color: rgb(255 255 255 / 0.8); }
  .titelbild { border-radius: var(--radius); margin-bottom: 2.5rem; max-height: 32rem; width: 100%; object-fit: cover; }
  .vorspann { font-weight: 700; }
</style>

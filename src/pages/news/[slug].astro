---
/** Einzelner News-Beitrag. Inhalt: src/content/news/<beitrag>.mdoc */
import Markdoc from '@markdoc/markdoc';
import Basis from '../../layouts/Basis.astro';
import { allgemein, alleNews, datumLang, reader } from '../../lib/inhalte';

export async function getStaticPaths() {
  const news = await alleNews();
  return news.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const beitrag = await reader.collections.news.readOrThrow(slug!);
const texte = await allgemein();
const thema = beitrag.thema ? await reader.collections.themen.read(beitrag.thema) : null;
const { node } = await beitrag.inhalt();
const html = Markdoc.renderers.html(Markdoc.transform(node));
---
<Basis titel={beitrag.titel} beschreibung={beitrag.kurztext || undefined}>
  <article>
    <header class="kopf dunkel">
      <div class="huelle schmal">
        <p class="meta">
          {beitrag.datum && <time datetime={beitrag.datum}>{datumLang(beitrag.datum)}</time>}
          {thema && <a href={`/themen/${beitrag.thema}`}>{thema.titel}</a>}
        </p>
        <h1>{beitrag.titel}</h1>
      </div>
    </header>

    <div class="huelle schmal text">
      {beitrag.titelbild && <img class="titelbild" src={beitrag.titelbild} alt={beitrag.titelbildBeschreibung} />}
      <Fragment set:html={html} />
      <p class="zurueck"><a href="/news">← {texte.zurueckNews}</a></p>
    </div>
  </article>
</Basis>

<style>
  .schmal { max-width: 46rem; }
  .kopf { background: var(--navy); color: var(--weiss); padding: clamp(2.5rem, 7vw, 4rem) 0 clamp(2rem, 5vw, 3rem); }
  .kopf h1 { font-size: clamp(2.2rem, 1.5rem + 3vw, 3.4rem); margin: 0; }
  .meta { display: flex; gap: 1rem; color: rgb(255 255 255 / 0.7); font-size: 1rem; }
  .text { padding: clamp(2rem, 5vw, 3rem) 0 clamp(3.5rem, 8vw, 5rem); }
  .titelbild { margin-bottom: 2rem; }
  .text :global(h2) { font-size: 1.7rem; margin: 2rem 0 0.6rem; }
  .text :global(img) { margin: 1.5rem 0; }
  .zurueck { margin-top: 2.5rem; font-family: var(--schrift-titel); font-weight: 600; }
</style>

---
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Projektliste from '../../components/Projektliste.astro';
import { projekte } from '../../lib/inhalte';

const alle = await projekte();
---
<Basis titel="Projekte" beschreibung="Die Projekte von ELIA: Modellraketen, Rover, Raketenprogramm, Space Law und Entrepreneurship.">
  <Seitenkopf
    titel="Projekte"
    einleitung="Von der Modellrakete bis zur Gründungsidee: Jede Projektgruppe arbeitet eigenständig und ist offen für neue Leute."
  />
  <section class="abschnitt huelle">
    <Projektliste projekte={alle} ueberschrift="h2" />
  </section>
</Basis>

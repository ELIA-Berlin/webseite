---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { reader, alsHtml } from '../lib/inhalte';

const seite = await reader.singletons.datenschutz.read();
const html = seite ? await alsHtml(seite.inhalt) : '';
---
<Basis titel="Datenschutz">
  <Seitenkopf titel="Datenschutzerklärung" />
  <section class="abschnitt huelle"><div class="prosa" set:html={html} /></section>
</Basis>

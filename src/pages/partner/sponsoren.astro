---
/**
 * Sponsoren & Partner: Logos der Sponsoren (nach Stufen) und institutionelle Partner.
 * Logos: Sammlung „Partner & Sponsoren“, Texte: src/content/seiten/partner.yaml
 */
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Abschnitt from '../../components/Abschnitt.astro';
import { reader, sichererLink } from '../../lib/inhalte';

const seite = await reader.singletons.partnerSeite.readOrThrow();
const alle = (await reader.collections.partner.all()).sort((a, b) => (a.entry.reihenfolge ?? 99) - (b.entry.reihenfolge ?? 99));
const sponsoren = alle.filter((p) => p.entry.art === 'sponsor');
const institutionen = alle.filter((p) => p.entry.art === 'institution');

// Externe Links öffnen in einem neuen Tab, damit man auf unserer Seite bleibt.
const neuerTab = (link?: string) => /^https?:\/\//i.test(sichererLink(link) ?? '') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
// Sponsoren nach Stufe gruppieren (Reihenfolge wie im Editor)
const stufen = new Map<string, typeof sponsoren>();
for (const s of sponsoren) {
  const stufe = s.entry.stufe || '';
  stufen.set(stufe, [...(stufen.get(stufe) ?? []), s]);
}
---
<Basis titel={seite.sponsorenSeiteTitel || 'Sponsoren & Partner'}>
  <Seitenkopf
    titel={seite.sponsorenSeiteTitel || 'Sponsoren & Partner'}
    einleitung={seite.sponsorenSeiteEinleitung}
  />

  <Abschnitt titel={seite.sponsorenTitel} leer={sponsoren.length === 0} platzhalter="Logos der Sponsoren, ggf. nach Stufen">
    {[...stufen].map(([stufe, liste]) => (
      <div class="stufe">
        {stufe && <h3>{stufe}</h3>}
        <ul class="logos">
          {liste.map(({ entry }) => {
            const Tag = sichererLink(entry.link) ? 'a' : 'div';
            return (
              <li>
                <Tag class="sponsor" href={sichererLink(entry.link)} {...neuerTab(entry.link)}>
                  <span class="sponsor__logo">
                    {entry.logo ? <img src={entry.logo} alt="" loading="lazy" /> : <span class="sponsor__ersatz">{entry.name}</span>}
                  </span>
                  <span class="sponsor__text">
                    <span class="sponsor__name">{entry.name}</span>
                    {entry.text && <span class="sponsor__beschreibung">{entry.text}</span>}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </Abschnitt>

  <Abschnitt titel={seite.institutionenTitel} leer={institutionen.length === 0} platzhalter="HTW Berlin, DGLR, internationale Kooperationen">
    <ul class="institutionen">
      {institutionen.map(({ entry }) => (
        <li>
          {entry.logo && <img src={entry.logo} alt="" loading="lazy" />}
          <div>
            <h3>{sichererLink(entry.link) ? <a href={sichererLink(entry.link)} {...neuerTab(entry.link)}>{entry.name}</a> : entry.name}</h3>
            {entry.text && <p>{entry.text}</p>}
          </div>
        </li>
      ))}
    </ul>
  </Abschnitt>

  {seite.sponsorenAufrufTitel && (
    <section class="aufruf-band">
      <div class="huelle">
        <div class="aufruf">
          <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="10" y="10" width="44" height="44" /><path d="M32 22 V42 M22 32 H42" /></svg>
          <div>
            <h2>{seite.sponsorenAufrufTitel}</h2>
            {seite.sponsorenAufrufText && <p>{seite.sponsorenAufrufText}</p>}
          </div>
          <a class="knopf" href="/partner/unterstuetzen">{seite.sponsorenAufrufKnopf}</a>
        </div>
      </div>
    </section>
  )}
</Basis>

<style>
  .stufe + .stufe { margin-top: 2rem; }
  .stufe h3 { font-size: 1.2rem; color: var(--grau); }
  .logos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 1rem; }
  /* Jede Kachel wie ein kleines Blatt: Logo oben, darunter Name und Kurztext */
  .sponsor { display: flex; flex-direction: column; height: 100%; border: 1.5px solid var(--navy); text-decoration: none; background: var(--weiss); }
  .sponsor__logo { display: grid; place-items: center; height: 8rem; padding: 1.4rem; border-bottom: 1px solid var(--navy); }
  .sponsor__logo img { max-height: 100%; max-width: 100%; width: auto; height: auto; object-fit: contain; }
  .sponsor__ersatz { font-family: var(--schrift-titel); font-weight: 700; font-size: 1.5rem; text-align: center; }
  .sponsor__text { display: grid; gap: 0.2rem; padding: 0.7rem 0.9rem 0.9rem; }
  .sponsor__name { font-family: var(--schrift-titel); font-weight: 600; font-size: 1.15rem; }
  .sponsor__beschreibung { color: var(--grau); font-size: 0.95rem; line-height: 1.45; }
  a.sponsor:hover .sponsor__logo { background: var(--ring); }
  a.sponsor:hover .sponsor__name { text-decoration: underline; text-underline-offset: 0.15em; }
  .institutionen { list-style: none; margin: 0; padding: 0; }
  .institutionen li { display: flex; gap: 1.2rem; align-items: flex-start; }
  .institutionen li + li { border-top: 1px solid var(--linie); padding-top: 1.2rem; margin-top: 1.2rem; }
  .institutionen img { width: 5rem; height: auto; }
  .institutionen h3 { margin-bottom: 0.3rem; }
  .institutionen p { margin: 0; color: var(--grau); }

  /* Aufruf im Stil von „Dein Bauteil fehlt noch“: gestrichelter Platz für ein weiteres Logo */
  .aufruf-band { padding: clamp(3rem, 7vw, 5rem) 0 clamp(4rem, 9vw, 6rem); }
  .aufruf {
    display: grid; gap: 1.2rem 2rem; align-items: center;
    padding: clamp(1.4rem, 3vw, 2rem); border: 1.5px dashed var(--navy);
  }
  @media (min-width: 48rem) { .aufruf { grid-template-columns: auto 1fr auto; } }
  .aufruf svg { width: 3.5rem; height: 3.5rem; fill: none; stroke: var(--navy); stroke-width: 1.5; }
  .aufruf svg rect { stroke-dasharray: 4 3; }
  .aufruf h2 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); margin: 0 0 0.3rem; }
  .aufruf p { margin: 0; color: var(--grau); max-width: 34rem; }
  .aufruf .knopf { justify-self: start; }
</style>

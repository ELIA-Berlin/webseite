---
/**
 * Mitmachen.
 * Texte: src/content/seiten/mitmachen.yaml (Editor: Seiten → Mitmachen)
 * Positionen: src/content/positionen/ (Editor: Inhalte → Offene Positionen)
 * Termine: src/content/termine/ (Editor: Inhalte → Termine) plus das regelmäßige Treffen,
 * das aus dem Rhythmus in mitmachen.yaml berechnet wird.
 */
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Absaetze from '../components/Absaetze.astro';
import { absaetze, allgemein, alleThemen, kommendeTermine, reader, sichererLink } from '../lib/inhalte';

const seite = await reader.singletons.mitmachen.readOrThrow();
const texte = await allgemein();
const email = seite.kontaktEmail || texte.kontaktEmail;
const leer = (text?: string | null) => absaetze(text).length === 0;

// Offene Positionen: nur aktive, „großer Bedarf“ zuerst, dann nach Reihenfolge
const themenNamen = Object.fromEntries((await alleThemen()).map((t) => [t.slug, t.entry.titel]));
const positionen = (await reader.collections.positionen.all())
  .filter((p) => p.entry.anzeigen)
  .sort((a, b) =>
    Number(b.entry.grosserBedarf) - Number(a.entry.grosserBedarf) ||
    (a.entry.reihenfolge ?? 99) - (b.entry.reihenfolge ?? 99));
const bewerben = (titel: string) =>
  `mailto:${email}?subject=${encodeURIComponent(`${seite.positionenBetreff ?? ''} ${titel}`.trim())}`;

// Banner: Die nächsten Treffen und Events stehen im HTML, das Skript unten zeigt
// jeweils das erste, das noch nicht vorbei ist. So stimmt das Banner auch ohne neues Veröffentlichen.
const termine = await kommendeTermine();
const treffen = termine.filter((t) => t.art === 'treffen').slice(0, 12);
const events = termine.filter((t) => t.art === 'event').slice(0, 12);
// Bis wann ein Termin im Banner steht: Treffen bis zu ihrer Startzeit, Events bis zum Ende des Tages.
const uhr = (text?: string) => {
  const m = text?.match(/(\d{1,2})[:.](\d{2})/);
  return m ? `${m[1].padStart(2, '0')}:${m[2]}` : null;
};
const sichtbarBis = (t: { datum: string; uhrzeit?: string; art: string }) =>
  `${t.datum}T${(t.art === 'treffen' && uhr(t.uhrzeit)) || '23:59'}`;
const datumText = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('de-DE', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Basis titel={seite.titel}>
  <Seitenkopf titel={seite.titel} einleitung={seite.einleitung}>
    {treffen.length > 0 && (
      <Fragment slot="feld">
        <div class="termin-feld">
          <dt>{seite.bannerTitel}</dt>
          <dd>{treffen.map((t, i) => (
            <span data-treffen={i} data-bis={sichtbarBis(t)} hidden={i > 0}><time datetime={t.datum}>{datumText(t.datum)}</time></span>
          ))}</dd>
        </div>
        <div>
          <dt>{seite.bannerBeginn || 'Beginn'}</dt>
          <dd>{treffen.map((t, i) => <span data-treffen={i} hidden={i > 0}>{t.uhrzeit ? `${t.uhrzeit} Uhr` : '–'}</span>)}</dd>
        </div>
        {treffen.some((t) => t.ort) && (
          <div>
            <dt>{seite.bannerOrt || 'Ort'}</dt>
            <dd>{treffen.map((t, i) => <span data-treffen={i} hidden={i > 0}>{t.ort || '–'}</span>)}</dd>
          </div>
        )}
        {seite.treffenWann && (
          <div>
            <dt>{seite.bannerRhythmus || 'Rhythmus'}</dt>
            <dd>{seite.treffenWann}</dd>
          </div>
        )}
        {events.length > 0 && (
          <div class="event-feld">
            <dt>{seite.bannerEvent}</dt>
            <dd>{events.map((e, i) => (
              <span data-event data-bis={sichtbarBis(e)} hidden={i > 0}>
                <time datetime={e.datum}>{datumText(e.datum)}</time>: {sichererLink(e.link) ? <a href={sichererLink(e.link)}>{e.titel}</a> : e.titel}
              </span>
            ))}</dd>
          </div>
        )}
      </Fragment>
    )}
  </Seitenkopf>

  <Abschnitt titel={seite.positionenTitel} leer={positionen.length === 0} platzhalter="offene Positionen unter Inhalte → Offene Positionen" id="positionen">
    {seite.positionenText && <p class="vorspann">{seite.positionenText}</p>}
    <ul class="positionen">
      {positionen.map(({ entry }) => {
        const einordnung = (entry.thema && themenNamen[entry.thema]) || entry.bereich;
        return (
          <li class:list={{ bedarf: entry.grosserBedarf }}>
            <div class="position__kopf">
              {einordnung && <span class="einordnung">{einordnung}</span>}
              {entry.grosserBedarf && <span class="marke-bedarf">{seite.positionenBedarf}</span>}
            </div>
            <h3>{entry.titel}</h3>
            {entry.beschreibung && <p>{entry.beschreibung}</p>}
            {entry.mitbringen && (
              <p class="mitbringen"><strong>{seite.positionenMitbringen}:</strong> {entry.mitbringen}</p>
            )}
            <a class="knopf knopf--rahmen" href={bewerben(entry.titel)}>{seite.positionenKnopf}</a>
          </li>
        );
      })}
    </ul>
  </Abschnitt>

  <Abschnitt titel={seite.fuerWenTitel} leer={leer(seite.fuerWenText)} platzhalter="alle Studiengänge, kein Vorwissen nötig">
    <Absaetze text={seite.fuerWenText} />
  </Abschnitt>

  <Abschnitt titel={seite.wasDuMachstTitel} leer={leer(seite.wasDuMachstText)} platzhalter="was man bei uns macht und lernt">
    <Absaetze text={seite.wasDuMachstText} />
  </Abschnitt>

  <Abschnitt titel={seite.einstiegTitel} leer={seite.einstiegSchritte.length === 0} platzhalter="Schritte, z. B. Treffen besuchen → Thema wählen → loslegen">
    <ol class="schritte">
      {seite.einstiegSchritte.map((s) => <li><h3>{s.titel}</h3>{s.text && <p>{s.text}</p>}</li>)}
    </ol>
  </Abschnitt>

  <Abschnitt titel={seite.kontaktTitel} id="kontakt">
    {seite.kontaktText && <p>{seite.kontaktText}</p>}
    <a class="knopf" href={`mailto:${email}`}>{texte.kontaktKnopf}</a>
  </Abschnitt>
</Basis>

<script>
  // Die Seite wird nur beim Veröffentlichen gebaut. Damit die Angaben zum nächsten Treffen
  // trotzdem stimmen, prüft der Browser selbst: Ein Treffen steht bis zu seiner Startzeit da,
  // danach rückt das nächste nach (Datum, Beginn und Ort gemeinsam). Events bis Tagesende.
  const jetzt = new Date().toLocaleString('sv-SE', { timeZone: 'Europe/Berlin' }).replace(' ', 'T').slice(0, 16);

  const treffen = [...document.querySelectorAll<HTMLElement>('[data-treffen][data-bis]')];
  const naechstes = treffen.find((el) => (el.dataset.bis ?? '') > jetzt)?.dataset.treffen;
  for (const el of document.querySelectorAll<HTMLElement>('[data-treffen]')) el.hidden = el.dataset.treffen !== naechstes;
  if (naechstes === undefined) document.querySelector<HTMLElement>('.termin-feld')?.closest('section')?.querySelector<HTMLElement>('.seitenkopf__feld')?.setAttribute('hidden', '');

  const events = [...document.querySelectorAll<HTMLElement>('[data-event]')];
  const naechstesEvent = events.find((el) => (el.dataset.bis ?? '') > jetzt);
  for (const el of events) el.hidden = el !== naechstesEvent;
  if (!naechstesEvent) document.querySelector<HTMLElement>('.event-feld')?.setAttribute('hidden', '');
</script>

<style>
  /* Offene Positionen */
  .vorspann { margin-bottom: 1.6rem; }
  .positionen { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--navy); }
  .positionen li { padding: 1.5rem 0 1.7rem; border-bottom: 1px solid var(--linie); }
  .position__kopf { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.8rem; min-height: 1.6rem; }
  .einordnung { font-size: 0.95rem; color: var(--grau); }
  .marke-bedarf {
    font-family: var(--schrift-titel); font-weight: 600; font-size: 0.95rem;
    padding: 0.1rem 0.5rem; border-radius: 3px; background: var(--navy); color: var(--weiss);
  }
  .positionen h3 { margin: 0.3rem 0 0.5rem; }
  .positionen p { color: var(--grau); margin-bottom: 0.7rem; }
  .mitbringen strong { color: var(--navy); font-weight: 600; }
  .positionen .knopf { margin-top: 0.3rem; font-size: 1rem; padding: 0.6rem 1.1rem; }

  /* Einstieg */
  .schritte { list-style: none; margin: 0; padding: 0; counter-reset: schritt; }
  .schritte li { counter-increment: schritt; position: relative; padding-left: 3rem; }
  .schritte li + li { margin-top: 1.4rem; }
  .schritte li::before {
    content: counter(schritt); position: absolute; left: 0; top: 0;
    width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--navy); font-family: var(--schrift-titel); font-weight: 700;
  }
  .schritte h3 { margin: 0.15rem 0 0.3rem; font-size: 1.3rem; }
  .schritte p { margin: 0; color: var(--grau); }

  /* Angaben zum nächsten Treffen im Schriftfeld des Seitenkopfs */
  .termin-feld :global(dd) { font-size: 1.35rem !important; }
</style>

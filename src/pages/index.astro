---
/**
 * Startseite. Die Texte kommen aus src/content/startseite.yaml
 * und lassen sich im Editor unter /keystatic → Startseite ändern.
 * Der Missionslog kommt aus „Über uns“ → Rückblick, die Themen aus der Sammlung „Themen“.
 */
import Basis from '../layouts/Basis.astro';
import Flugprofil from '../components/Flugprofil.astro';
import ThemenBlaetter from '../components/ThemenBlaetter.astro';
import Missionslog from '../components/Missionslog.astro';
import { absaetze, allgemein, alleThemen, reader } from '../lib/inhalte';

const start = await reader.singletons.startseite.readOrThrow();
const ueberUns = await reader.singletons.ueberUns.readOrThrow();
const texte = await allgemein();
const themen = await alleThemen();
const [ersterAbsatz, ...weitereAbsaetze] = absaetze(start.werWirSindText);
---
<Basis>
  <section class="hero dunkel raster leuchten">
    <div class="huelle hero__raster">
      <div class="hero__text">
        {start.unterzeile && <p class="unterzeile">{start.unterzeile}</p>}
        <h1>{start.titel}</h1>
        <p class="einleitung">{start.einleitung}</p>
        <p class="aktionen">
          <a class="knopf" href="/mitmachen">{start.knopfMitmachen}</a>
          <a class="knopf knopf--rahmen" href="/themen">{start.knopfThemen}</a>
        </p>
      </div>
      <Flugprofil b={start.flugprofil} />
    </div>
  </section>

  <section class="wer">
    <div class="huelle zwei">
      <h2>{start.werWirSindTitel}</h2>
      <div>
        {ersterAbsatz && <p class="gross">{ersterAbsatz}</p>}
        {weitereAbsaetze.map((absatz) => <p class="leise">{absatz}</p>)}
      </div>
    </div>
  </section>

  <section class="themen" id="themen">
    <div class="huelle">
      <ThemenBlaetter themen={themen} einordnungName={texte.themaBereich || undefined} wettbewerbName={texte.themaWettbewerb || undefined} />
      {start.themenAufruf.titel && (
        <div class="bauteil">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect x="10" y="10" width="44" height="44" />
            <path d="M32 22 V42 M22 32 H42" />
          </svg>
          <div>
            {start.themenAufruf.einordnung && <span class="einordnung">{start.themenAufruf.einordnung}</span>}
            <h3>{start.themenAufruf.titel}</h3>
            <p>{start.themenAufruf.text}</p>
          </div>
          <a class="knopf" href="/mitmachen">{start.themenAufruf.link}</a>
        </div>
      )}
    </div>
  </section>

  {start.missionslogTitel && (
    <Missionslog
      titel={start.missionslogTitel}
      eintraege={ueberUns.rueckblick}
      link={{ text: start.missionslogLink, href: '/ueber-uns' }}
    />
  )}

  <section class="mitmachen">
    <div class="huelle zwei">
      <h2>{start.mitmachenTitel}</h2>
      <div>
        <p class="gross">{start.mitmachenText}</p>
        <a class="knopf" href={`mailto:${start.mitmachenEmail || texte.kontaktEmail}`}>{start.mitmachenKnopf}</a>
      </div>
    </div>
  </section>
</Basis>

<style>
  /* Kopfbereich: Raster wie auf einer technischen Zeichnung, rechts die Rakete */
  .hero { --raster-y: -73px; color: var(--weiss); overflow: hidden; }
  .hero__raster { display: grid; gap: 2.5rem; padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2.5rem, 6vw, 4.5rem); align-items: center; }
  .hero__text { padding-bottom: 0; }
  .unterzeile {
    font-family: var(--schrift-titel); font-weight: 500; font-size: 1.15rem;
    letter-spacing: 0.02em; color: rgb(255 255 255 / 0.62); margin-bottom: 1.4rem;
  }
  .einleitung { font-size: 1.25rem; max-width: 33rem; color: rgb(255 255 255 / 0.82); margin: 1.6rem 0 2.2rem; }
  .aktionen { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 0; }

  @media (min-width: 60rem) {
    .hero__raster { grid-template-columns: 1fr 1.05fr; gap: 3rem; }
  }

  /* Wer wir sind */
  .wer { padding: clamp(4rem, 9vw, 7rem) 0; }
  .zwei { display: grid; gap: 1.2rem 5rem; }
  @media (min-width: 50rem) { .zwei { grid-template-columns: 1fr 2fr; } }
  .gross { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.55rem); line-height: 1.45; max-width: 40rem; }
  .leise { color: var(--grau); max-width: 38rem; }

  /* Themen und Aufruf */
  .themen { padding-bottom: clamp(4rem, 9vw, 7rem); }
  .bauteil {
    display: grid; gap: 1.2rem 2rem; align-items: center;
    margin-top: 2.5rem; padding: 1.8rem; border: 1.5px dashed var(--navy);
  }
  .bauteil svg { width: 4rem; height: 4rem; }
  .bauteil rect { fill: none; stroke: var(--navy); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .bauteil path { fill: none; stroke: var(--navy); stroke-width: 1.6; }
  .bauteil h3 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); margin: 0.1rem 0 0.3rem; }
  .bauteil p { margin: 0; color: var(--grau); }
  .einordnung { font-size: 0.95rem; color: var(--grau); }
  @media (min-width: 46rem) { .bauteil { grid-template-columns: auto 1fr auto; } }

  /* Mach mit */
  .mitmachen { background: var(--ring); padding: clamp(3.5rem, 8vw, 5.5rem) 0; }
  .mitmachen .zwei { align-items: start; }
  .mitmachen h2 { font-size: clamp(2.6rem, 1.6rem + 4vw, 4.6rem); margin: 0; }
  .mitmachen .gross { color: var(--navy); margin: 0.4rem 0 1.8rem; }
</style>

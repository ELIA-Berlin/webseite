# Diese Werte entstehen beim einmaligen Einrichten (npm run keystatic:setup)
# und werden zusätzlich in Netlify unter Site configuration → Environment variables eingetragen.
# Niemals echte Werte ins Repo committen.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
